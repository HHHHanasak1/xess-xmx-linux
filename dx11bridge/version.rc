// version.rc - the version of libxess_dx11.dll: the XeSS API version it implements. DXVK's DXGI hides the Intel GPU
// (reports it as AMD) while a libxess_dx11.dll without a version, or one older than 2.0.2.68, is loaded
// (isXessVendorWaNeeded() in dxgi_options.cpp); XeSS then never reaches XMX.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2, 0, 2, 68
PRODUCTVERSION 2, 0, 2, 68
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "xess-xmx-linux"
            VALUE "FileDescription", "XeSS super resolution for D3D11 on the D3D12 XeSS (xess-xmx-linux)"
            VALUE "FileVersion", "2.0.2.68"
            VALUE "InternalName", "libxess_dx11.dll"
            VALUE "OriginalFilename", "libxess_dx11.dll"
            VALUE "ProductName", "xess-xmx-linux"
            VALUE "ProductVersion", "2.0.2.68"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
