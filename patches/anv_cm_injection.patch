+                              const uint32_t idx = pc[cm->cm_table_pc_off[k] / 4] + cm->cm_elem[k];
+                              const uint32_t *ss2 = (const uint32_t *)((const char *)hs->desc_surface_mem.map +
+                                                                       cm->cm_heap_desc_off + idx * cm->cm_heap_stride);
+                              const uint32_t fmt2 = (ss2[0] >> 18) & 0x1ff;
+                              const uint64_t a2 = (((uint64_t)ss2[9] << 32) | ss2[8]) & 0xffffffffffffull;
+                              const uint32_t sz2 = ss2[11];
+                              if (fmt2 != 0x1ff || sz2 == 0 || sz2 > 4096 || gused + sz2 > (4u << 20))
+                                 continue;
+                              mi_memcpy(&mb, (struct anv_address){ .bo = gbo, .offset = gused },
+                                        (struct anv_address){ .bo = NULL, .offset = a2 }, sz2);
+                              grec[gnrec].kx = gkx; grec[gnrec].ky = gky; grec[gnrec].k = k; grec[gnrec].size = sz2; grec[gnrec].off = gused;
+                              grec[gnrec].n = sn; grec[gnrec].due = gcount[gkx][gky] + 40; grec[gnrec].done = false; gnrec++;
+                              gused += (sz2 + 63) & ~63u;
+                           }
+                           fprintf(stderr, "ANV CM: gcap %u,%u n=%u queued %u surfaces\n", gkx, gky, sn, gnrec);
+                        }
+                     }
+                     gp += used;
+                     if (*gp == ';') gp++;
+                  }
+                  if (gbo) {
+                     for (unsigned r = 0; r < gnrec; r++) {
+                        if (!grec[r].done && grec[r].kx == gkx && grec[r].ky == gky && gcount[gkx][gky] >= grec[r].due) {
+                           char path[128];
+                           snprintf(path, sizeof(path), "/tmp/anv_cm_cap/gcap_%u_%u_n%u_s%u.bin", grec[r].kx, grec[r].ky, grec[r].n, grec[r].k);
+                           FILE *gf = fopen(path, "wb");
+                           if (gf) { fwrite((const char *)gbo->map + grec[r].off, 1, grec[r].size, gf); fclose(gf); }
+                           grec[r].done = true;
+                           fprintf(stderr, "ANV CM: gcap wrote %s\n", path);
+                        }
+                     }
+                  }
+               }
+            }
+            /* ANV_CM_CAPTURE="kx,ky:N": at the N-th dispatch of kernel kx,ky dump every buffer surface it uses to cap_<kx>_<ky>_s<k>.bin */
+            const char *capenv = getenv("ANV_CM_CAPTURE");
+            static unsigned cap_count[17][11];
+            unsigned ckx = cm->cm_id & 0xff, cky = cm->cm_id >> 8, cn = 0;
+            bool do_cap = false;
+            if (capenv && ckx < 17 && cky < 11) {
+               /* spec list "kx,ky:N;kx,ky:N" */
+               const char *cp = capenv;
+               unsigned sx, sy, sn;
+               int used;
+               ++cap_count[ckx][cky];
+               while (sscanf(cp, "%u,%u:%u%n", &sx, &sy, &sn, &used) == 3) {
+                  if (sx == ckx && sy == cky && cap_count[ckx][cky] == sn) { do_cap = true; cn = sn; }
+                  cp += used;
+                  if (*cp == ';') cp++;
+               }
+            }
+            if (do_cap) {
+               extern struct anv_bo *anv_cm_bos[];
+               extern unsigned anv_cm_nbos;
+               for (uint32_t k = 0; k < cm->cm_nsurf; k++) {
+                  const uint32_t idx = pc[cm->cm_table_pc_off[k] / 4] + cm->cm_elem[k];
+                  const uint32_t *ss = (const uint32_t *)((const char *)hs->desc_surface_mem.map +
+                                                          cm->cm_heap_desc_off + idx * cm->cm_heap_stride);
+                  const uint32_t fmt = (ss[0] >> 18) & 0x1ff;
+                  const uint64_t addr = (((uint64_t)ss[9] << 32) | ss[8]) & 0xffffffffffffull;
+                  const uint64_t size = ss[11];
+                  if (fmt != 0x1ff || size == 0)
+                     continue;
+                  struct anv_bo *found = NULL;
+                  for (unsigned i = 0; i < anv_cm_nbos; i++) {
+                     struct anv_bo *b = anv_cm_bos[i];
+                     const uint64_t bo_va = b->offset & 0xffffffffffffull;
+                     if (bo_va <= addr && addr + size <= bo_va + b->size) { found = b; break; }
+                  }
+                  if (!found) {
+                     fprintf(stderr, "ANV CM: capture surf %u addr %llx size %llu: no BO\n", k, (unsigned long long)addr, (unsigned long long)size);
+                     continue;
+                  }
+                  void *m = found->map;
+                  if (!m && anv_device_map_bo(cmd_buffer->device, found, 0, found->size, NULL, &m) != VK_SUCCESS) {
+                     fprintf(stderr, "ANV CM: capture surf %u: map failed\n", k);
+                     continue;
+                  }
+                  char path[128];
+                  snprintf(path, sizeof(path), "/tmp/anv_cm_cap/cap_%u_%u_n%u_s%u.bin", ckx, cky, cn, k);
+                  FILE *cf = fopen(path, "wb");
+                  if (cf) {
+                     fwrite((const char *)m + (addr - (found->offset & 0xffffffffffffull)), 1, size, cf);
+                     fclose(cf);
+                  }
+                  fprintf(stderr, "ANV CM: captured surf %u (%llu bytes @%llx) -> %s\n", k, (unsigned long long)size, (unsigned long long)addr, path);
+               }
+            }
+         }
+         return VK_SUCCESS;
+      }
+   }
