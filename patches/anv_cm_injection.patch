+/* ---- CM native kernel injection (experimental) ------------------------------------------------------------
+ * A compute shader whose entry point is named "cm_<name>" is replaced by the pre-compiled Intel Xe3 binary
+ * $ANV_CM_KERNEL_DIR/cm_<name>.cmk (see tools: cmk_pack.py). The Vulkan shader only provides the descriptor
+ * bindings (bind_map); the code, GRF count, SLM and payload come from the file. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+struct cmk_header {
+   char magic[4];               /* "CMK2" */
+   uint32_t code_size;
+   uint32_t grf_count;
+   uint32_t slm_size;
+   uint32_t barriers;
+   uint32_t lws[3];
+   uint32_t cross_size;         /* bytes of cross-thread data (GRF multiple) */
+   uint32_t per_thread_size;    /* bytes of per-thread data (GRF multiple, packed local ids) */
+   uint8_t cross_data[128];
+   uint32_t heap_set;           /* descriptor set holding the vkd3d-style descriptor heap */
+   uint32_t heap_binding;       /* binding of the heap in that set */
+   uint32_t table_pc_base;      /* byte offset of the first descriptor-table offset in the push constants */
+   uint32_t nsurf;
+   uint32_t bti[24];            /* binding table index of surface k */
+   uint32_t table_idx[24];      /* descriptor table number (push constant slot) of surface k */
+   uint32_t elem[24];           /* element inside the table */
+};
+
+static bool
+anv_cm_kernel_replace(struct anv_device *device, void *mem_ctx,
+                      struct anv_shader_data *shader_data, nir_shader *nir)
+{
+   const char *dir = getenv("ANV_CM_KERNEL_DIR");
+   if (!dir)
+      return false;
+   char hex[33];
+   for (int i = 0; i < 16; i++)
+      snprintf(hex + 2 * i, 3, "%02x", nir->info.source_blake3[i]);
+   char path[512];
+   snprintf(path, sizeof(path), "%s/%s.cmk", dir, hex);
+   if (getenv("ANV_CM_DEBUG")) {
+      const struct vk_shader_compile_info *ci = shader_data->info;
+      fprintf(stderr, "ANV CM: compute shader blake3 %s wg %u,%u,%u sets %u surfaces %u samplers %u push_ranges %u\n", hex,
+              nir->info.workgroup_size[0], nir->info.workgroup_size[1], nir->info.workgroup_size[2],
+              ci->set_layout_count, shader_data->bind_map.surface_count, shader_data->bind_map.sampler_count,
+              (unsigned)ARRAY_SIZE(shader_data->bind_map.push_ranges));
+      for (uint32_t i = 0; i < ci->set_layout_count; i++) {
+         if (!ci->set_layouts[i])
+            continue;
+         const struct anv_descriptor_set_layout *l = (const struct anv_descriptor_set_layout *)ci->set_layouts[i];
+         fprintf(stderr, "ANV CM:   set %u: type %d bindings %u descriptors %u\n", i, (int)l->type, l->binding_count, l->descriptor_count);
+         for (uint32_t b = 0; b < l->binding_count && b < 16; b++)
+            fprintf(stderr, "ANV CM:     binding %u: vktype %d array %u flags 0x%x\n", b, (int)l->binding[b].type, l->binding[b].array_size, (unsigned)l->binding[b].flags);
+      }
+      for (uint32_t i = 0; i < shader_data->bind_map.surface_count && i < 16; i++)
+         fprintf(stderr, "ANV CM:   surface %u: set %u index %u\n", i, shader_data->bind_map.surface_to_descriptor[i].set, shader_data->bind_map.surface_to_descriptor[i].index);
+   }
+   if (access(path, R_OK) != 0) {
+      /* dummy pipelines made by the igdext shim encode the XeSS kernel index in the workgroup size (x, y, 5) */
+      if (nir->info.workgroup_size[2] != 5)
+         return false;
+      snprintf(path, sizeof(path), "%s/wg%u_%u_5.cmk", dir,
+               nir->info.workgroup_size[0], nir->info.workgroup_size[1]);
+      if (access(path, R_OK) != 0)
+         return false;
+   }
+   {
+      /* debugging: ANV_CM_ONLY="x,y x,y ..." injects only these kernels, ANV_CM_SKIP the listed ones are left as dummies */
+      const uint32_t kx = nir->info.workgroup_size[0], ky = nir->info.workgroup_size[1];
+      char key[32], onlyp[2048], skipp[2048];
+      snprintf(key, sizeof(key), " %u,%u ", kx, ky);
+      const char *only = getenv("ANV_CM_ONLY"), *skip = getenv("ANV_CM_SKIP");
+      snprintf(onlyp, sizeof(onlyp), " %s ", only ? only : "");
+      snprintf(skipp, sizeof(skipp), " %s ", skip ? skip : "");
+      if (nir->info.workgroup_size[2] == 5 &&
+          ((only && !strstr(onlyp, key)) || (skip && strstr(skipp, key)))) {
+         fprintf(stderr, "ANV CM: kernel %s not injected (ONLY/SKIP)\n", key);
+         return false;
+      }
+   }
+   FILE *f = fopen(path, "rb");
+   if (!f) {
+      fprintf(stderr, "ANV CM: cannot open %s\n", path);
+      return false;
+   }
+   struct cmk_header h;
+   if (fread(&h, sizeof(h), 1, f) != 1 || memcmp(h.magic, "CMK2", 4) != 0 ||
+       h.code_size == 0 || h.code_size > (16u << 20)) {
+      fprintf(stderr, "ANV CM: bad header in %s\n", path);
+      fclose(f);
+      return false;
+   }
+   void *code = ralloc_size(mem_ctx, h.code_size);
+   if (fread(code, 1, h.code_size, f) != h.code_size) {
+      fprintf(stderr, "ANV CM: short read in %s\n", path);
+      fclose(f);
+      return false;
+   }
+   fclose(f);
+
+   struct brw_cs_prog_data *cs = &shader_data->prog_data.cs;
+   memset(cs, 0, sizeof(*cs));
+   cs->base.program_size = h.code_size;
+   cs->base.grf_used = h.grf_count;
+   cs->base.total_shared = h.slm_size;
+   cs->uses_barrier = (h.barriers & 0x7fffffffu) > 0;
+   cs->cm_has_sampler = (h.barriers & 0x80000000u) != 0;
+   /* One HW thread per CM work item: dispatch as SIMD32 over lws*32 so that threads == lws.x*lws.y*lws.z */
+   cs->local_size[0] = h.lws[0] * 32;
+   cs->local_size[1] = h.lws[1];
+   cs->local_size[2] = h.lws[2];
+   cs->prog_mask = 1 << 2;
+   cs->prog_offset[2] = 0;
+   cs->uses_cm_kernel = true;
+   cs->cm_id = nir->info.workgroup_size[2] == 5 ? (nir->info.workgroup_size[0] | (nir->info.workgroup_size[1] << 8)) : 0;
+   memcpy(cs->cm_local, h.lws, sizeof(h.lws));
+   cs->cm_cross_thread_size = h.cross_size;
+   cs->cm_per_thread_size = h.per_thread_size;
+   memcpy(cs->cm_cross_thread_data, h.cross_data, sizeof(h.cross_data));
+
+   if (h.nsurf > 0) {
+      const struct vk_shader_compile_info *ci = shader_data->info;
+      const struct anv_descriptor_set_layout *l = NULL;
+      const bool auto_heap = h.heap_set == 0xffffffffu;
+      if (auto_heap) {
+         /* vkd3d-proton: the descriptor heap is the MUTABLE binding with a huge array */
+         for (uint32_t i = 0; i < ci->set_layout_count && !l; i++) {
+            const struct anv_descriptor_set_layout *cand =
+               (const struct anv_descriptor_set_layout *)ci->set_layouts[i];
+            if (!cand)
+               continue;
+            for (uint32_t b = 0; b < cand->binding_count; b++) {
+               if (cand->binding[b].type == VK_DESCRIPTOR_TYPE_MUTABLE_EXT &&
+                   cand->binding[b].array_size >= 1000) {
+                  h.heap_set = i;
+                  h.heap_binding = b;
+                  l = cand;
+                  break;
+               }
+            }
+         }
+      } else if (h.heap_set < ci->set_layout_count && ci->set_layouts[h.heap_set]) {
+         l = (const struct anv_descriptor_set_layout *)ci->set_layouts[h.heap_set];
+      }
+      if (auto_heap) {
+         /* vkd3d push constants end with one u32 per descriptor-table root parameter; the kernel's surfaces are
+          * the last h.nsurf tables (table_idx counts from the first of those) */
+         uint32_t push_size = 0;
+         for (uint32_t r = 0; r < ci->push_constant_range_count; r++)
+            push_size = MAX2(push_size, ci->push_constant_ranges[r].offset + ci->push_constant_ranges[r].size);
+         h.table_pc_base = push_size - 4 * h.nsurf;
+      }
+      if (!l || h.heap_binding >= l->binding_count || h.nsurf > 24) {
+         fprintf(stderr, "ANV CM: %s needs heap set %u binding %u but the pipeline layout has %u sets\n",
+                 path, h.heap_set, h.heap_binding, ci->set_layout_count);
+         return false;
+      }
+      cs->cm_nsurf = h.nsurf;
+      cs->cm_heap_set = h.heap_set;
+      cs->cm_heap_desc_off = l->binding[h.heap_binding].descriptor_surface_offset;
+      cs->cm_heap_stride = l->binding[h.heap_binding].descriptor_surface_stride;
+      for (uint32_t k = 0; k < h.nsurf; k++) {
+         cs->cm_bti[k] = h.bti[k];
+         cs->cm_table_pc_off[k] = h.table_pc_base + 4 * h.table_idx[k];
+         cs->cm_elem[k] = h.elem[k];
+         cs->cm_max_bti = MAX2(cs->cm_max_bti, h.bti[k]);
+      }
+      fprintf(stderr, "ANV CM: heap set %u binding %u: descriptor offset %u stride %u (set layout type %d)\n",
+              h.heap_set, h.heap_binding, cs->cm_heap_desc_off, cs->cm_heap_stride, (int)l->type);
+   }
+
+   shader_data->bind_map.inline_dwords_count = 0;
+   shader_data->num_stats = 1;
+   memset(&shader_data->stats[0], 0, sizeof(shader_data->stats[0]));
+   shader_data->stats[0].dispatch_width = 32;
+   shader_data->code = code;
+
+   fprintf(stderr, "ANV CM: injected %s (%u bytes code, %u GRF, lws %u,%u,%u, %u surfaces in bind map)\n",
+           path, h.code_size, h.grf_count, h.lws[0], h.lws[1], h.lws[2],
+           shader_data->bind_map.surface_count);
+   return true;
+}
