diff --git a/src/intel/vulkan/anv_shader_compile.c b/src/intel/vulkan/anv_shader_compile.c
index 7f2c77b..f5d968f 100644
--- a/src/intel/vulkan/anv_shader_compile.c
+++ b/src/intel/vulkan/anv_shader_compile.c
@@ -1204,6 +1204,388 @@ anv_shader_compile_fs(struct anv_device *device,
    }
 }
 
+/* ---- C-for-Metal kernel injection (xess-xmx-linux) ------------------------------------------------------------
+ * The igdext shim turns every C-for-Metal kernel XeSS submits into a placeholder D3D12 compute shader. The
+ * placeholder stores ANV_CM_DUMMY_MAGIC and its workgroup size encodes a kernel id:
+ *  - static ids (x, y, 5): prebuilt kernel $ANV_CM_KERNEL_DIR/wg<x>_<y>_5.cmk (developer option, IGDEXT_STATIC=1)
+ *  - dynamic ids on the z = 7 / 11 / 13 planes: the shim wrote the kernel's SPIR-V + options and its hash to
+ *    $WINEPREFIX/drive_c/igdext_kernels; the kernel is compiled on first use (ANV_CM_HELPER, default
+ *    <package>/tools/cm-compile.sh) into the per-user cache ~/.cache/xess-xmx/kernels/<hash>_<pci id>.cmk.
+ * The placeholder's bindings only provide the pipeline layout; code, GRF count, SLM and payload come from the .cmk
+ * file (tools/cmk_pack.py). Placeholders are never stored in the pipeline cache, so a changed kernel or a compile
+ * that failed once is picked up again on the next launch. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <errno.h>
+#include <sys/stat.h>
+#include "util/u_call_once.h"
+
+#define ANV_CM_DUMMY_MAGIC 0x584d5843u   /* stored by every placeholder shader of the shim */
+
+static struct anv_cm_env anv_cm_env_data;
+static util_once_flag anv_cm_env_once = UTIL_ONCE_FLAG_INIT;
+
+static void
+anv_cm_env_init(void)
+{
+   struct anv_cm_env *e = &anv_cm_env_data;
+   e->kernel_dir = getenv("ANV_CM_KERNEL_DIR");
+   e->debug = getenv("ANV_CM_DEBUG") != NULL;
+   const char *t = getenv("ANV_CM_TRACE");
+   e->trace = t ? (t[0] == '2' ? 2 : 1) : 0;
+}
+
+const struct anv_cm_env *
+anv_cm_env(void)
+{
+   util_call_once(&anv_cm_env_once, anv_cm_env_init);
+   return &anv_cm_env_data;
+}
+
+struct cmk_header {
+   char magic[4];               /* "CMK2" */
+   uint32_t code_size;
+   uint32_t grf_count;
+   uint32_t slm_size;
+   uint32_t barriers;           /* bit 31: kernel samples through a sampler */
+   uint32_t lws[3];
+   uint32_t cross_size;         /* bytes of cross-thread data (GRF multiple) */
+   uint32_t per_thread_size;    /* bytes of per-thread data (GRF multiple, packed local ids) */
+   uint8_t cross_data[128];
+   uint32_t heap_set;           /* descriptor set holding the vkd3d-style descriptor heap (~0 = find it) */
+   uint32_t heap_binding;       /* binding of the heap in that set */
+   uint32_t table_pc_base;      /* byte offset of the first descriptor-table offset in the push constants */
+   uint32_t nsurf;
+   uint32_t bti[24];            /* binding table index of surface k */
+   uint32_t table_idx[24];      /* descriptor table number (push constant slot) of surface k */
+   uint32_t elem[24];           /* element inside the table */
+};
+
+/* True if the shader is one of the shim's placeholders: tiny, and it stores ANV_CM_DUMMY_MAGIC. A real game shader
+ * that happens to use the same workgroup size is left alone. */
+static bool
+anv_cm_is_placeholder(nir_shader *nir)
+{
+   unsigned n = 0;
+   bool magic = false;
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (++n > 256)
+               return false;
+            if (instr->type != nir_instr_type_load_const)
+               continue;
+            nir_load_const_instr *lc = nir_instr_as_load_const(instr);
+            if (lc->def.bit_size != 32)
+               continue;
+            for (unsigned c = 0; c < lc->def.num_components; c++)
+               magic |= lc->value[c].u32 == ANV_CM_DUMMY_MAGIC;
+         }
+      }
+   }
+   return magic;
+}
+
+/* Dynamic ids: planes z = 7, 11, 13; inside a plane every (x, y) with x * y * z <= 1024, ordered by y then x.
+ * Must match tools/gen_dyn_dummies.py. */
+static const uint32_t anv_cm_dyn_planes[] = { 7, 11, 13 };
+
+static int
+anv_cm_dyn_id(uint32_t wx, uint32_t wy, uint32_t wz)
+{
+   int base = 0;
+   for (unsigned p = 0; p < ARRAY_SIZE(anv_cm_dyn_planes); p++) {
+      const uint32_t z = anv_cm_dyn_planes[p], lim = 1024 / z;
+      if (wz == z) {
+         if (wx < 1 || wy < 1 || wx * wy > lim)
+            return -1;
+         int id = base;
+         for (uint32_t y = 1; y < wy; y++)
+            id += lim / y;
+         return id + (int)(wx - 1);
+      }
+      for (uint32_t y = 1; y <= lim; y++)
+         base += lim / y;
+   }
+   return -1;
+}
+
+static void
+anv_cm_mkdirs(const char *path)
+{
+   char tmp[512];
+   snprintf(tmp, sizeof(tmp), "%s", path);
+   for (char *p = tmp + 1; *p; p++) {
+      if (*p == '/') {
+         *p = 0;
+         mkdir(tmp, 0755);
+         *p = '/';
+      }
+   }
+   mkdir(tmp, 0755);
+}
+
+/* Resolves a dynamic id to its packed kernel, compiling it on a cache miss. */
+static bool
+anv_cm_dyn_kernel(struct anv_device *device, int id, char *path, size_t pathlen)
+{
+   const struct anv_cm_env *env = anv_cm_env();
+   char dirbuf[512];
+   const char *sdir = getenv("ANV_CM_SPV_DIR");
+   if (!sdir) {
+      const char *pfx = getenv("WINEPREFIX");
+      if (!pfx)
+         return false;
+      snprintf(dirbuf, sizeof(dirbuf), "%s/drive_c/igdext_kernels", pfx);
+      sdir = dirbuf;
+   }
+   /* kernel hash from the shim's map ("<id> <hash>") */
+   char mappath[600], hash[32] = "";
+   snprintf(mappath, sizeof(mappath), "%s/map.txt", sdir);
+   FILE *mf = fopen(mappath, "r");
+   if (mf) {
+      char line[128], h[32];
+      int i;
+      while (fgets(line, sizeof(line), mf))
+         if (sscanf(line, "%d %31s", &i, h) == 2 && i == id)
+            snprintf(hash, sizeof(hash), "%s", h);
+      fclose(mf);
+   }
+   if (!hash[0]) {
+      fprintf(stderr, "ANV CM: dynamic kernel %d not in %s\n", id, mappath);
+      return false;
+   }
+   char cdir[512];
+   const char *xdg = getenv("XDG_CACHE_HOME");
+   if (xdg && xdg[0])
+      snprintf(cdir, sizeof(cdir), "%s/xess-xmx/kernels", xdg);
+   else
+      snprintf(cdir, sizeof(cdir), "%s/.cache/xess-xmx/kernels", getenv("HOME") ? getenv("HOME") : "/tmp");
+   snprintf(path, pathlen, "%s/%s_%04x.cmk", cdir, hash, device->info->pci_device_id);
+   if (access(path, R_OK) == 0)
+      return true;
+
+   char spv[600], opt[600];
+   snprintf(spv, sizeof(spv), "%s/dyn_%d.spv", sdir, id);
+   snprintf(opt, sizeof(opt), "%s/dyn_%d.opt", sdir, id);
+   if (access(spv, R_OK) != 0 || access(opt, R_OK) != 0) {
+      fprintf(stderr, "ANV CM: dynamic kernel %d: no %s\n", id, spv);
+      return false;
+   }
+   anv_cm_mkdirs(cdir);
+   char helperbuf[600];
+   const char *helper = getenv("ANV_CM_HELPER");
+   if (!helper) {
+      if (!env->kernel_dir)
+         return false;
+      snprintf(helperbuf, sizeof(helperbuf), "%s/../tools/cm-compile.sh", env->kernel_dir);
+      helper = helperbuf;
+   }
+   char cmd[2600];
+   snprintf(cmd, sizeof(cmd), "CM_PCI_ID=0x%04x /bin/sh '%s' '%s' '%s' '%s'", device->info->pci_device_id,
+            helper, spv, opt, path);
+   fprintf(stderr, "ANV CM: compiling kernel %d (%s)\n", id, hash);
+   const int rc = system(cmd);
+   if (rc != 0 || access(path, R_OK) != 0) {
+      fprintf(stderr, "ANV CM: kernel %d (%s): compile failed (rc %d)\n", id, hash, rc);
+      /* tells the shim to fall back to XeSS' DP4a path on the next launch (see README, troubleshooting) */
+      char mark[600];
+      snprintf(mark, sizeof(mark), "%s/compile_failed.txt", sdir);
+      FILE *ff = fopen(mark, "a");
+      if (ff) {
+         fprintf(ff, "%d %s\n", id, hash);
+         fclose(ff);
+      }
+      return false;
+   }
+   return true;
+}
+
+/* The pipeline layout's static sampler (vkd3d-proton turns D3D12 static samplers into immutable samplers). */
+static unsigned
+anv_cm_layout_sampler(const struct vk_shader_compile_info *ci, uint32_t state[4])
+{
+   unsigned count = 0;
+   for (uint32_t i = 0; i < ci->set_layout_count; i++) {
+      const struct anv_descriptor_set_layout *l = (const struct anv_descriptor_set_layout *)ci->set_layouts[i];
+      if (!l)
+         continue;
+      for (uint32_t b = 0; b < l->binding_count; b++) {
+         const struct anv_descriptor_set_binding_layout *bl = &l->binding[b];
+         if (!bl->samplers)
+            continue;
+         for (uint32_t e = 0; e < bl->array_size; e++) {
+            const uint32_t *s = bl->samplers[e].immutable_sampler ?
+                                bl->samplers[e].immutable_sampler->state[0] :
+                                bl->samplers[e].embedded_key.sampler;
+            if (count++ == 0)
+               memcpy(state, s, 4 * sizeof(uint32_t));
+         }
+      }
+   }
+   return count;
+}
+
+enum anv_cm_result {
+   ANV_CM_NOT_PLACEHOLDER,
+   ANV_CM_INJECTED,
+   ANV_CM_FAILED,        /* placeholder whose kernel is missing: compiled as the (no-op) placeholder, not cached */
+};
+
+static enum anv_cm_result
+anv_cm_kernel_replace(struct anv_device *device, void *mem_ctx,
+                      struct anv_shader_data *shader_data, nir_shader *nir)
+{
+   const struct anv_cm_env *env = anv_cm_env();
+   const uint32_t wx = nir->info.workgroup_size[0], wy = nir->info.workgroup_size[1], wz = nir->info.workgroup_size[2];
+   char path[512] = "";
+   const int dyn = anv_cm_dyn_id(wx, wy, wz);
+   if (!path[0]) {
+      if (wz != 5 && dyn < 0)
+         return ANV_CM_NOT_PLACEHOLDER;
+      if (!anv_cm_is_placeholder(nir)) {
+         if (env->debug)
+            fprintf(stderr, "ANV CM: workgroup %u,%u,%u is not a placeholder, left alone\n", wx, wy, wz);
+         return ANV_CM_NOT_PLACEHOLDER;
+      }
+      if (wz == 5) {
+         if (!env->kernel_dir)
+            return ANV_CM_FAILED;
+         snprintf(path, sizeof(path), "%s/wg%u_%u_5.cmk", env->kernel_dir, wx, wy);
+         if (access(path, R_OK) != 0) {
+            fprintf(stderr, "ANV CM: no %s\n", path);
+            return ANV_CM_FAILED;
+         }
+      } else if (!anv_cm_dyn_kernel(device, dyn, path, sizeof(path))) {
+         return ANV_CM_FAILED;
+      }
+   }
+   if (env->debug) {
+      const struct vk_shader_compile_info *ci = shader_data->info;
+      fprintf(stderr, "ANV CM: placeholder wg %u,%u,%u -> %s (sets %u)\n", wx, wy, wz, path, ci->set_layout_count);
+      for (uint32_t i = 0; i < ci->set_layout_count; i++) {
+         if (!ci->set_layouts[i])
+            continue;
+         const struct anv_descriptor_set_layout *l = (const struct anv_descriptor_set_layout *)ci->set_layouts[i];
+         fprintf(stderr, "ANV CM:   set %u: type %d bindings %u descriptors %u\n", i, (int)l->type, l->binding_count, l->descriptor_count);
+      }
+   }
+   FILE *f = fopen(path, "rb");
+   if (!f) {
+      fprintf(stderr, "ANV CM: cannot open %s\n", path);
+      return ANV_CM_FAILED;
+   }
+   struct cmk_header h;
+   if (fread(&h, sizeof(h), 1, f) != 1 || memcmp(h.magic, "CMK2", 4) != 0 ||
+       h.code_size == 0 || h.code_size > (16u << 20)) {
+      fprintf(stderr, "ANV CM: bad header in %s\n", path);
+      fclose(f);
+      return ANV_CM_FAILED;
+   }
+   void *code = ralloc_size(mem_ctx, h.code_size);
+   if (fread(code, 1, h.code_size, f) != h.code_size) {
+      fprintf(stderr, "ANV CM: short read in %s\n", path);
+      fclose(f);
+      return ANV_CM_FAILED;
+   }
+   fclose(f);
+
+   struct brw_cs_prog_data *cs = &shader_data->prog_data.cs;
+   const struct brw_cs_prog_data saved = *cs;
+   memset(cs, 0, sizeof(*cs));
+   cs->base.program_size = h.code_size;
+   cs->base.grf_used = h.grf_count;
+   cs->base.total_shared = h.slm_size;
+   cs->uses_barrier = (h.barriers & 0x7fffffffu) > 0;
+   cs->cm_has_sampler = (h.barriers & 0x80000000u) != 0;
+   /* One HW thread per CM work item: dispatch as SIMD32 over lws*32 so that threads == lws.x*lws.y*lws.z */
+   cs->local_size[0] = h.lws[0] * 32;
+   cs->local_size[1] = h.lws[1];
+   cs->local_size[2] = h.lws[2];
+   cs->prog_mask = 1 << 2;
+   cs->prog_offset[2] = 0;
+   cs->uses_cm_kernel = true;
+   cs->cm_no_cache = true;
+   cs->cm_id = wx | (wy << 8) | (wz << 16);
+   memcpy(cs->cm_local, h.lws, sizeof(h.lws));
+   cs->cm_cross_thread_size = h.cross_size;
+   cs->cm_per_thread_size = h.per_thread_size;
+   memcpy(cs->cm_cross_thread_data, h.cross_data, sizeof(h.cross_data));
+
+   const struct vk_shader_compile_info *ci = shader_data->info;
+   if (cs->cm_has_sampler) {
+      const unsigned ns = anv_cm_layout_sampler(ci, cs->cm_sampler_state);
+      cs->cm_sampler_from_layout = ns > 0;
+      if (ns != 1)
+         fprintf(stderr, "ANV CM: %s samples but the pipeline layout has %u static samplers (%s)\n", path, ns,
+                 ns ? "using the first" : "using linear/clamp");
+   }
+
+   if (h.nsurf > 0) {
+      const struct anv_descriptor_set_layout *l = NULL;
+      const bool auto_heap = h.heap_set == 0xffffffffu;
+      if (auto_heap) {
+         /* vkd3d-proton: the descriptor heap is the MUTABLE binding with a huge array */
+         for (uint32_t i = 0; i < ci->set_layout_count && !l; i++) {
+            const struct anv_descriptor_set_layout *cand =
+               (const struct anv_descriptor_set_layout *)ci->set_layouts[i];
+            if (!cand)
+               continue;
+            for (uint32_t b = 0; b < cand->binding_count; b++) {
+               if (cand->binding[b].type == VK_DESCRIPTOR_TYPE_MUTABLE_EXT &&
+                   cand->binding[b].array_size >= 1000) {
+                  h.heap_set = i;
+                  h.heap_binding = b;
+                  l = cand;
+                  break;
+               }
+            }
+         }
+      } else if (h.heap_set < ci->set_layout_count && ci->set_layouts[h.heap_set]) {
+         l = (const struct anv_descriptor_set_layout *)ci->set_layouts[h.heap_set];
+      }
+      if (auto_heap) {
+         /* vkd3d push constants end with one u32 per descriptor-table root parameter; the kernel's surfaces are
+          * the last h.nsurf tables (table_idx counts from the first of those) */
+         uint32_t push_size = 0;
+         for (uint32_t r = 0; r < ci->push_constant_range_count; r++)
+            push_size = MAX2(push_size, ci->push_constant_ranges[r].offset + ci->push_constant_ranges[r].size);
+         h.table_pc_base = push_size >= 4 * h.nsurf ? push_size - 4 * h.nsurf : ~0u;
+      }
+      if (!l || h.heap_binding >= l->binding_count || h.nsurf > 24 || h.table_pc_base == ~0u) {
+         fprintf(stderr, "ANV CM: %s: no vkd3d-style descriptor heap in the pipeline layout (%u sets) - "
+                 "is VKD3D_DISABLE_EXTENSIONS=VK_EXT_descriptor_buffer set?\n", path, ci->set_layout_count);
+         *cs = saved;
+         return ANV_CM_FAILED;
+      }
+      cs->cm_nsurf = h.nsurf;
+      cs->cm_heap_set = h.heap_set;
+      cs->cm_heap_desc_off = l->binding[h.heap_binding].descriptor_surface_offset;
