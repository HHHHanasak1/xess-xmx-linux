From 6bfeffd290e488f5f6fba0524786b00428f6c9ba Mon Sep 17 00:00:00 2001
From: xess-xmx-linux <xmx@localhost>
Date: Sun, 4 Oct 2026 17:08:57 -0300
Subject: [PATCH 3/3] anv: enable Large GRF Mode around CM kernels on Xe2
 (xess-xmx-linux)

The CM kernels are compiled with -doubleGRF (256 registers) and every
kernel prologue uses r255. Xe3 sizes the register file per shader
(variable register allocation, RegistersPerThread), but Xe2 has a single
engine-wide switch, STATE_COMPUTE_MODE Large GRF Mode, which nothing
enabled. A 256-GRF kernel then runs in 128-GRF mode, touches registers it
does not own, its threads never retire and the engine hangs (rcs/ccs reset
after the job timeout). Seen on an Arc B580 with every CM kernel, including
a trivial one, in Cyberpunk 2077 and Wuthering Waves; the devcoredump
showed "Large GRF Mode: false".

Xe-HPG (Alchemist, DG2; also Meteor/Arrow Lake graphics, GFX 12.5) has the
same switch in STATE_COMPUTE_MODE and hangs the same way: an A310 hung in
the first CM kernel of Satisfactory (i915 error state: walker of a
256-GRF CM kernel, Large GRF Mode off in the batch and in the context
image). The switch is therefore used on GFX 12.5 as well as on Xe2.

genX(cmd_buffer_set_cm_large_grf)() switches the mode with an end-of-pipe
sync and HDC/untyped flush, only when it changes; the last programmed state
is tracked in anv_cmd_compute_state. It is turned on before CM walkers with
more than 128 GRF and off before any other compute walker (BLORP compute
operations, trace rays, internal shaders and generated commands
included), at the end of every command buffer and before executing
secondaries, so each command buffer starts and ends with it off.
Ordinary shaders are correct in Large GRF mode (they only lose occupancy),
so on is the safe direction.

BLORP compute operations (buffer copies and fills between dispatches)
emit their own STATE_COMPUTE_MODE and COMPUTE_WALKER and bypassed the
tracking, so Large GRF Mode stayed on across them. On the A310 the next CM
kernel after such a BLORP walker hung, in every error state (at different
kernels, depending on which ones were skipped). Switching the mode off at
the start of blorp_exec_on_compute() fixed it in Satisfactory: 0 of 4 runs
hung with the change, 4 of 4 without it. Whether the BLORP walker or its
STATE_COMPUTE_MODE is the trigger was not narrowed down.

The other compute walkers that do not go through emit_compute_walker()
bypassed it the same way and now switch the mode off first as well:
trace rays (vkCmdTraceRaysKHR and its indirect forms), the driver's
internal simple shaders (genX_simple_shader.c, e.g. the query and
indirect-generation kernels) and, from Mesa 26.3 on, the compute and
ray tracing paths of vkCmdExecuteGeneratedCommandsEXT. XeSS runs right
before or after ray tracing in games like Cyberpunk 2077.

Tested on an Arc B580 (Xe2) with the 26.3.0-rc2 build of this series:
Cyberpunk 2077 benchmark, 2560x1440, XeSS SR Performance on XMX (XeSS
2.0.2.68 libraries), ray tracing on (no path tracing): 44.7-44.8 fps
average without the change (three runs), 44.8 fps with it. Both had an
engine reset (1 in 4 runs without, 1 in 3 with). The error dump captured
(with the change) hung in the 3D pipeline, at a RESOURCE_BARRIER after a
draw, with Large GRF Mode off in the context, so it is not this path. No
hang was traced to Large GRF Mode staying on before these walkers; the
change closes the same gap the BLORP one did. 26.1.2: build-tested only.

Toggling once per run of consecutive CM dispatches instead of around each
one matters: Cyberpunk 2077 benchmark (2560x1440, XeSS SR, measured on
the Mesa main version of this change) went from 110.0 fps (stall pair per
dispatch) to 134.3 fps, against 126.0 fps on the DP4a path.

Also skip direct CM walkers with a zero group count in one dimension (XeSS
dispatches 0x720x1 for one kernel). The Vulkan spec makes such a dispatch a
no-op; this was not shown to cause the hang and is kept only for spec
conformance.

Only touches code outside the XMX-DEBUG blocks, so it applies on top of
0001 alone as well as on 0001 + 0002.
---
 src/intel/vulkan/anv_genX.h           |  3 ++
 src/intel/vulkan/anv_private.h        |  4 ++
 src/intel/vulkan/genX_blorp_exec.c    |  7 ++++
 src/intel/vulkan/genX_cmd_buffer.c    | 12 ++++++
 src/intel/vulkan/genX_cmd_compute.c   | 60 +++++++++++++++++++++++++++
 src/intel/vulkan/genX_cmd_dgc.c       |  8 ++++
 src/intel/vulkan/genX_simple_shader.c |  4 ++
 7 files changed, 98 insertions(+)

diff --git a/src/intel/vulkan/anv_genX.h b/src/intel/vulkan/anv_genX.h
index fc7c416..033e29e 100644
--- a/src/intel/vulkan/anv_genX.h
+++ b/src/intel/vulkan/anv_genX.h
@@ -390,6 +390,9 @@ genX(batch_set_preemption)(struct anv_batch *batch,
 void
 genX(cmd_buffer_set_preemption)(struct anv_cmd_buffer *cmd_buffer, bool value);
 
+void
+genX(cmd_buffer_set_cm_large_grf)(struct anv_cmd_buffer *cmd_buffer, bool enable);
+
 void
 genX(batch_emit_pipe_control)(struct anv_batch *batch,
                               const struct intel_device_info *devinfo,
diff --git a/src/intel/vulkan/anv_private.h b/src/intel/vulkan/anv_private.h
index f34c8dc..f3d0b04 100644
--- a/src/intel/vulkan/anv_private.h
+++ b/src/intel/vulkan/anv_private.h
@@ -4723,6 +4723,10 @@ struct anv_cmd_compute_state {
    uint8_t pixel_async_compute_thread_limit;
    uint8_t z_pass_async_compute_thread_limit;
    uint8_t np_z_async_throttle_settings;
+
+   /* Xe-HPG, Xe2: STATE_COMPUTE_MODE Large GRF Mode as last programmed by this command buffer (xess-xmx-linux CM
+    * kernels need it). Every command buffer starts and ends with it off, so 0 = off is the initial state. */
+   bool cm_large_grf;
 };
 
 struct anv_cmd_ray_tracing_state {
diff --git a/src/intel/vulkan/genX_blorp_exec.c b/src/intel/vulkan/genX_blorp_exec.c
index 2f537fd..f588d75 100644
--- a/src/intel/vulkan/genX_blorp_exec.c
+++ b/src/intel/vulkan/genX_blorp_exec.c
@@ -469,6 +469,13 @@ blorp_exec_on_compute(struct blorp_batch *batch,
    struct anv_cmd_buffer *cmd_buffer = batch->driver_batch;
    assert(cmd_buffer->queue_family->queueFlags & VK_QUEUE_COMPUTE_BIT);
 
+#if GFX_VERx10 == 125 || GFX_VER == 20
+   /* BLORP emits its own STATE_COMPUTE_MODE and COMPUTE_WALKER, outside the CM Large GRF tracking: switch the
+    * mode off first (CM kernels may have left it on), the next CM walker switches it back on. Left on across a
+    * BLORP walker, the next CM kernel hung on an A310 (xess-xmx-linux #28). */
+   genX(cmd_buffer_set_cm_large_grf)(cmd_buffer, false);
+#endif
+
    genX(flush_pipeline_select_gpgpu)(cmd_buffer, false);
 
    /* Apply any outstanding flushes in case pipeline select haven't. */
diff --git a/src/intel/vulkan/genX_cmd_buffer.c b/src/intel/vulkan/genX_cmd_buffer.c
index 11c858f..fe11897 100644
--- a/src/intel/vulkan/genX_cmd_buffer.c
+++ b/src/intel/vulkan/genX_cmd_buffer.c
@@ -4663,6 +4663,12 @@ end_command_buffer(struct anv_cmd_buffer *cmd_buffer,
     */
    genX(apply_task_urb_workaround)(cmd_buffer);
 
+   /* Leave STATE_COMPUTE_MODE Large GRF Mode off (CM kernels may have left it on), so the next command
+    * buffer on this context can assume it starts off. */
+#if GFX_VERx10 == 125 || GFX_VER == 20
+   genX(cmd_buffer_set_cm_large_grf)(cmd_buffer, false);
+#endif
+
    genX(cmd_buffer_apply_pipe_flushes)(cmd_buffer);
 
    if (cmd_buffer->vk.level == VK_COMMAND_BUFFER_LEVEL_PRIMARY)
@@ -4733,6 +4739,12 @@ genX(CmdExecuteCommands)(
     */
    genX(cmd_buffer_enable_pma_fix)(container, false);
 
+   /* The secondaries likewise assume Large GRF Mode is off when they begin (and they turn it off again
+    * before they end), so the container's tracked state stays valid across them. */
+#if GFX_VERx10 == 125 || GFX_VER == 20
+   genX(cmd_buffer_set_cm_large_grf)(container, false);
+#endif
+
    /* Turn on preemption in case it was toggled off. */
    if (!container->state.gfx.object_preemption)
       genX(cmd_buffer_set_preemption)(container, true);
diff --git a/src/intel/vulkan/genX_cmd_compute.c b/src/intel/vulkan/genX_cmd_compute.c
index 5fa7e7e..aca2e29 100644
--- a/src/intel/vulkan/genX_cmd_compute.c
+++ b/src/intel/vulkan/genX_cmd_compute.c
@@ -468,6 +468,38 @@ get_interface_descriptor_data_tables(struct anv_cmd_buffer *cmd_buffer)
    };
 }
 
+void
+genX(cmd_buffer_set_cm_large_grf)(struct anv_cmd_buffer *cmd_buffer, bool enable)
+{
+#if GFX_VERx10 == 125 || GFX_VER == 20
+   /* CM kernels (xess-xmx-linux) are compiled with -doubleGRF: 256 registers, and every kernel's prologue
+    * uses r255. Xe3 sizes the register file per shader (variable register allocation), but Xe-HPG and Xe2 have one
+    * engine-wide switch, STATE_COMPUTE_MODE Large GRF Mode. Without it a 256-GRF kernel runs in 128-GRF
+    * mode, touches registers it does not own, its threads never retire and the engine hangs (seen on a
+    * B580 in every game using the CM path, and on an A310 in Satisfactory).
+    *
+    * The mode is only switched when it changes, so a run of consecutive CM dispatches (XeSS issues dozens
+    * per frame) pays for one transition instead of two per dispatch. Ordinary shaders are correct in Large
+    * GRF Mode (they only lose occupancy), so the mode is switched back off before the next non-CM compute
+    * walker and at the end of every command buffer, which also lets each command buffer assume it starts
+    * off. The stall on each side is needed because the mode applies to every thread in flight. */
+   if (cmd_buffer->state.compute.cm_large_grf == enable)
+      return;
+
+   anv_add_pending_pipe_bits(cmd_buffer, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                             VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                             ANV_PIPE_END_OF_PIPE_SYNC_BIT | ANV_PIPE_HDC_PIPELINE_FLUSH_BIT |
+                             ANV_PIPE_UNTYPED_DATAPORT_CACHE_FLUSH_BIT,
+                             enable ? "CM large GRF on" : "CM large GRF off");
+   genX(cmd_buffer_apply_pipe_flushes)(cmd_buffer);
+   anv_batch_emit(&cmd_buffer->batch, GENX(STATE_COMPUTE_MODE), cm) {
+      cm.LargeGRFMode = enable;
+      cm.LargeGRFModeMask = true;
+   }
+   cmd_buffer->state.compute.cm_large_grf = enable;
+#endif
+}
+
 static void
 compute_update_async_threads_limit(struct anv_cmd_buffer *cmd_buffer,
                                    const struct brw_cs_prog_data *prog_data,
@@ -577,6 +609,9 @@ emit_indirect_compute_walker(struct anv_cmd_buffer *cmd_buffer,
    const struct intel_cs_dispatch_info dispatch =
       brw_cs_get_dispatch_info(devinfo, prog_data, NULL);
 
+   genX(cmd_buffer_set_cm_large_grf)(cmd_buffer, prog_data->uses_cm_kernel &&
+                                                 prog_data->base.grf_used > 128);
+
    uint64_t indirect_addr64 = anv_address_physical(indirect_addr);
 
    struct anv_bind_point_state *bind_state = comp_state->base;
@@ -688,6 +723,26 @@ emit_compute_walker(struct anv_cmd_buffer *cmd_buffer,
                  num_wg[0], num_wg[1], num_wg[2], dispatch.threads);
    }
 
+   /* XeSS issues direct dispatches with a zero group count in one dimension (seen in Cyberpunk 2077:
+    * kernel 94a4f8ea with 0x720x1). The Vulkan spec makes such a dispatch a no-op, so drop the walker
+    * instead of handing the hardware a zero ThreadGroupID*Dimension (it was suspected, but not shown,
+    * to be involved in the Xe2 hang that turned out to be Large GRF Mode). Keep the pre/post dispatch
+    * workaround pairing. */
+   if (prog_data->uses_cm_kernel && anv_address_is_null(indirect_addr) &&
+       (num_wg[0] == 0 || num_wg[1] == 0 || num_wg[2] == 0)) {
+      if (anv_cm_env()->trace)
+         fprintf(stderr, "ANV CM: skipping empty dispatch kernel %u,%u,%u groups %u,%u,%u\n",
+                 prog_data->cm_id & 0xff, (prog_data->cm_id >> 8) & 0xff, prog_data->cm_id >> 16,
+                 num_wg[0], num_wg[1], num_wg[2]);
+      cmd_buffer_post_dispatch_wa(cmd_buffer, false);
+      return;
+   }
+
+   /* Large GRF Mode on for 256-GRF CM kernels, off again for everything else (see
+    * genX(cmd_buffer_set_cm_large_grf)); a no-op unless the mode actually changes. */
+   genX(cmd_buffer_set_cm_large_grf)(cmd_buffer, prog_data->uses_cm_kernel &&
+                                                 prog_data->base.grf_used > 128);
+
    uint64_t push_addr64 = anv_address_physical(
       anv_state_pool_state_address(anv_device_get_dynamic_state_pool(device),
                                    bind_state->push_constants_state));
@@ -1536,6 +1591,11 @@ cmd_buffer_trace_rays(struct anv_cmd_buffer *cmd_buffer,
 
    trace_intel_begin_rays(&cmd_buffer->trace);
 
+#if GFX_VERx10 == 125 || GFX_VER == 20
+   /* Large GRF Mode off: CM kernels may have left it on (see genX(cmd_buffer_set_cm_large_grf)). */
+   genX(cmd_buffer_set_cm_large_grf)(cmd_buffer, false);
+#endif
+
    cmd_buffer->state.rt.trace_rays_active = true;
 
    /* Allocate and set up our RT_DISPATCH_GLOBALS */
diff --git a/src/intel/vulkan/genX_cmd_dgc.c b/src/intel/vulkan/genX_cmd_dgc.c
index b4bb2b9..f6a76c9 100644
--- a/src/intel/vulkan/genX_cmd_dgc.c
+++ b/src/intel/vulkan/genX_cmd_dgc.c
@@ -874,6 +874,10 @@ void genX(CmdExecuteGeneratedCommandsEXT)(
       struct anv_cmd_compute_state *comp_state = &cmd_buffer->state.compute;
 
       genX(flush_pipeline_select_gpgpu)(cmd_buffer, false);
+#if GFX_VERx10 == 125 || GFX_VER == 20
+      /* Large GRF Mode off: CM kernels may have left it on (see genX(cmd_buffer_set_cm_large_grf)). */
+      genX(cmd_buffer_set_cm_large_grf)(cmd_buffer, false);
+#endif
 
       if (pGeneratedCommandsInfo->sequenceCountAddress != 0) {
          struct anv_address seq_count_addr =
@@ -1018,6 +1022,10 @@ void genX(CmdExecuteGeneratedCommandsEXT)(
       struct anv_bind_point_state *bind_state = rt_state->base;
 
       genX(flush_pipeline_select_gpgpu)(cmd_buffer, false);
+#if GFX_VERx10 == 125 || GFX_VER == 20
+      /* Large GRF Mode off: CM kernels may have left it on (see genX(cmd_buffer_set_cm_large_grf)). */
+      genX(cmd_buffer_set_cm_large_grf)(cmd_buffer, false);
+#endif
 
       genX(flush_binding_mode)(cmd_buffer, bind_state, ANV_RT_STAGE_BITS);
 
diff --git a/src/intel/vulkan/genX_simple_shader.c b/src/intel/vulkan/genX_simple_shader.c
index ec762ba..cc591bd 100644
--- a/src/intel/vulkan/genX_simple_shader.c
+++ b/src/intel/vulkan/genX_simple_shader.c
@@ -404,6 +404,10 @@ genX(emit_simpler_shader_init_compute)(struct anv_simple_shader *state)
    const struct brw_cs_prog_data *prog_data =
       (const struct brw_cs_prog_data *) cs_bin->prog_data;
    if (state->cmd_buffer != NULL) {
+#if GFX_VERx10 == 125 || GFX_VER == 20
+      /* Large GRF Mode off: CM kernels may have left it on (see genX(cmd_buffer_set_cm_large_grf)). */
+      genX(cmd_buffer_set_cm_large_grf)(state->cmd_buffer, false);
+#endif
       genX(cmd_buffer_ensure_cfe_state)(state->cmd_buffer,
                                         prog_data->base.total_scratch);
    } else {
-- 
