From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Calder Young <calder.young@intel.com>
Date: Thu, 22 Oct 2026 11:04:28 -0700
Subject: [PATCH] jay: Avoid lowering helper predication in more cases

Now that we sometimes lower demote to terminate, we can stop tracking helper
lanes in those cases because its just the lanes that were already halted.

Signed-off-by: Calder Young <calder.young@intel.com>
Reviewed-by: Kenneth Graunke <kenneth@whitecape.org>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/46045>
(cherry picked from commit b3b7c5e4974f6e0c68f0d7a0b2b87bc16f16228d)

Backport to Mesa 26.3.1 (xess-xmx-linux). 26.3.1 carries the commit before
it, "jay: Lower demote to terminate unless the shader uses derivatives"
(64141f32c75, main d445f7168f2), without this one; with only that commit,
fragment shaders can hang the GPU (render engine reset). Adapted to 26.3:
- jay_lower_helpers.c: setup_exit_block() keeps the 26.3.1 code; its first
  branch is the case main now asserts, the null RT write stays as fallback.
- jay_from_nir.c: jay_alloc_def() takes (file, count) on 26.3, without the
  bit size argument of main.
---
 src/intel/compiler/brw/brw_nir.c      |  17 +++-
 src/intel/compiler/jay/jay_from_nir.c | 113 +++++++++++++++++++++++---
 src/intel/compiler/jay/jay_nir.c      |  34 ++++----
 3 files changed, 134 insertions(+), 30 deletions(-)

diff --git a/src/intel/compiler/brw/brw_nir.c b/src/intel/compiler/brw/brw_nir.c
index a22194afd4b..0d5e6da55bf 100644
--- a/src/intel/compiler/brw/brw_nir.c
+++ b/src/intel/compiler/brw/brw_nir.c
@@ -3879,11 +3879,22 @@ brw_postprocess_nir_opts(brw_pass_tracker *pt)
       .lower_boolean_shuffle = jay,
    };
 
-   if (OPT(nir_opt_uniform_atomics, false))
+   /* TODO: Unify this with the logic in jay_prog_data somehow */
+   const bool uses_helpers =
+      pt->nir->info.stage == MESA_SHADER_FRAGMENT &&
+      (pt->nir->info.fs.needs_coarse_quad_helper_invocations ||
+       pt->nir->info.uses_wide_subgroup_intrinsics ||
+       pt->nir->info.maximally_reconverges ||
+       !jay);
+
+   if (OPT(nir_opt_uniform_atomics, !uses_helpers)) {
       OPT(nir_lower_subgroups, &subgroups_options);
+   }
 
-   if (pt->key->divergent_atomics_flags)
-      OPT(brw_nir_opt_divergent_atomics, pt->key->divergent_atomics_flags, false);
+   if (pt->key->divergent_atomics_flags) {
+      OPT(brw_nir_opt_divergent_atomics, pt->key->divergent_atomics_flags,
+          !uses_helpers);
+   }
 
    /* nir_opt_uniform_subgroup can create some operations (e.g.,
     * load_subgroup_lt_mask) that need to be lowered again.
diff --git a/src/intel/compiler/jay/jay_from_nir.c b/src/intel/compiler/jay/jay_from_nir.c
index b3c2971270a..1ef1b00e75f 100644
--- a/src/intel/compiler/jay/jay_from_nir.c
+++ b/src/intel/compiler/jay/jay_from_nir.c
@@ -2505,15 +2505,20 @@ jay_emit_intrinsic(struct nir_to_jay_state *nj, nir_intrinsic_instr *intr)
       break;
 
    case nir_intrinsic_demote:
-      jay_DEMOTE_u32(b, jay_null(), jay_null());
+      if (s->helpers_tracked) {
+         jay_DEMOTE_u32(b, jay_null(), jay_null());
+      }
       break;
    case nir_intrinsic_demote_if:
-      jay_DEMOTE(b, JAY_TYPE_U1, nj_src(intr->src[0]), 0)->conditional_mod =
-         GEN_CONDITION_NE;
+      if (s->helpers_tracked) {
+         jay_DEMOTE(b, JAY_TYPE_U1, nj_src(intr->src[0]), 0)->conditional_mod =
+            GEN_CONDITION_NE;
+      }
       break;
 
    case nir_intrinsic_load_helper_invocation:
    case nir_intrinsic_is_helper_invocation:
+      assert(s->helpers_tracked);
       jay_IS_HELPER(b, dst);
       break;
 
@@ -4039,18 +4044,100 @@ jay_emit_eot(struct nir_to_jay_state *nj)
    const struct intel_device_info *devinfo = b->shader->devinfo;
 
    /* Jump target for HALT */
-   if (nj->needs_final_halt) {
-      if (nj->s->stage == MESA_SHADER_FRAGMENT) {
-         assert(nj->s->helpers_tracked);
-      } else {
-         jay_HALT_TARGET(&nj->bld);
-      }
+   if (nj->needs_final_halt && !nj->s->helpers_tracked) {
+      jay_HALT_TARGET(&nj->bld);
    }
 
-   if (mesa_shader_stage_is_compute(nj->nir->info.stage) ||
-       mesa_shader_stage_is_rt(nj->nir->info.stage) ||
-       nj->nir->info.stage == MESA_SHADER_MESH ||
-       nj->nir->info.stage == MESA_SHADER_TASK) {
+   if (nj->nir->info.stage == MESA_SHADER_FRAGMENT) {
+      /* There should already be an EOT in pretty much any shader, so we don't
+       * want to double up on EOT writes everywhere.
+       */
+      jay_inst *I = jay_last_inst(jay_last_source_block(nj->f));
+      bool needs_eot = !(I && I->op == JAY_OPCODE_SEND && jay_send_eot(I));
+
+      /* In cases where we don't track helpers separately from control flow,
+       * we still need a jump target for when all lanes get demoted and EOT
+       * the thread without a RT write.
+       */
+      bool needs_halt = nj->needs_final_halt && !nj->s->helpers_tracked;
+
+      if (needs_eot || needs_halt) {
+         unsigned width = MIN2(b->shader->dispatch_width,
+                               reg_unit(b->shader->devinfo) * 16);
+         unsigned op =
+            width == 32 ?
+               XE2_DATAPORT_RENDER_TARGET_WRITE_SIMD32_SINGLE_SOURCE :
+            width == 16 ?
+               BRW_DATAPORT_RENDER_TARGET_WRITE_SIMD16_SINGLE_SOURCE :
+               BRW_DATAPORT_RENDER_TARGET_WRITE_SIMD8_SINGLE_SOURCE_SUBSPAN01;
+         uint64_t desc = brw_fb_write_desc(b->shader->devinfo, 0, op, true, false);
+         uint64_t ex_desc = (1 << 20) /* null rt */;
+         unsigned gprs = 4;
+         unsigned ugprs = 0;
+
+         struct brw_fs_prog_data *prog_data = &b->shader->prog_data->fs;
+
+         /* We seem to hang unless the payload size matches the state that was
+          * programmed in 3DSTATE_PS_EXTRA.
+          */
+         gprs += (prog_data->computed_depth_mode ? 1 : 0);
+         ugprs += (prog_data->computed_stencil ? 1 : 0) +
+                  (prog_data->uses_omask       ? 1 : 0);
+
+         if (prog_data->computed_stencil && prog_data->uses_omask) {
+            /* match demand with the existing RT writes */
+            ugprs += gprs * jay_grf_per_gpr_at_width(b->shader, width);
+            gprs = 0;
+         }
+
+         ugprs *= jay_ugpr_per_grf(b->shader);
+
+         if (devinfo->ver >= 20) {
+            ex_desc |=
+               (prog_data->computed_stencil    ? (1 << 14) : 0) |
+               (prog_data->computed_depth_mode ? (1 << 13) : 0) |
+               (prog_data->uses_omask          ? (1 << 12) : 0);
+         }
+
+         jay_def pred = jay_null();
+         
+         if (!nj->s->helpers_tracked) {
+            /* There's no flag register being initialized to predicate the
+             * instruction, we have to prepare one ourselves.
+             */
+            pred = jay_alloc_def(b, FLAG, 1);
+            jay_MOV(b, pred, 0);
+         }
+
+         unsigned srcs = 0;
+         jay_def dummy_pld[2];
+
+         if (gprs) {
+            dummy_pld[srcs++] = jay_alloc_def(b, GPR, gprs);
+         }
+
+         if (ugprs) {
+            dummy_pld[srcs++] = jay_alloc_def(b, UGPR, ugprs);
+         }
+
+         for (unsigned i = 0; i < srcs; ++i) {
+            jay_UNDEF(b, dummy_pld[i]);
+         }
+
+         jay_inst *send =
+            jay_SEND(b, .sfid = GEN_SFID_RENDER_CACHE,
+                     .msg_desc = desc | (ex_desc << 32), .nr_srcs = srcs,
+                     .srcs = dummy_pld, .type = JAY_TYPE_U32, .eot = true,
+                     .skip_helpers = jay_is_null(pred), .simd_width = width);
+
+         if (!jay_is_null(pred)) {
+            send = jay_add_predicate(b, send, pred, jay_null());
+         }
+      }
+   } else if (mesa_shader_stage_is_compute(nj->nir->info.stage) ||
+              mesa_shader_stage_is_rt(nj->nir->info.stage) ||
+              nj->nir->info.stage == MESA_SHADER_MESH ||
+              nj->nir->info.stage == MESA_SHADER_TASK) {
       jay_def u0 = nj->payload.u0;
 
       /* Vectorized copy into the EOT register. Not necessary for correctness
diff --git a/src/intel/compiler/jay/jay_nir.c b/src/intel/compiler/jay/jay_nir.c
index 1fe6655b1ea..ef3a7d96379 100644
--- a/src/intel/compiler/jay/jay_nir.c
+++ b/src/intel/compiler/jay/jay_nir.c
@@ -1251,21 +1251,27 @@ jay_process_nir_for_simd(const struct intel_device_info *devinfo,
    if (nir->info.stage == MESA_SHADER_FRAGMENT) {
       /* Certain features require tracking helpers for correctness */
       nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
-      *track_helpers |= nir->info.fs.uses_discard || nir->info.writes_memory;
-      *track_helpers |= BITSET_TEST(nir->info.system_values_read,
-                                    SYSTEM_VALUE_HELPER_INVOCATION);
 
-      /* ...but this is more subtle. nir_opt_load_skip_helpers flags texturing
-       * operations that we can skip for bandwidth savings.  We need divergence
-       * info for this, so we run late.
-       *
-       * We may or may not want to force track_helpers on if this makes
-       * progress. Possibly driconf'ing on furmark makes sense.
-       */
-      struct nir_opt_load_skip_helpers_options skip_helpers = {
-         .no_add_divergence = true
-      };
-      JAY_NIR_PASS(nir_opt_load_skip_helpers, &skip_helpers);
+      if (params->prog_data->fs.uses_vmask || nir->info.maximally_reconverges) {
+         *track_helpers |= nir->info.fs.uses_discard | nir->info.writes_memory;
+         *track_helpers |= BITSET_TEST(nir->info.system_values_read,
+                                       SYSTEM_VALUE_HELPER_INVOCATION);
+
+         if (params->prog_data->fs.uses_vmask || nir->info.fs.uses_discard) {
+            /* ...but this is more subtle. nir_opt_load_skip_helpers flags
+             * texturing operations that we can skip for bandwidth savings.  We
+             * need divergence info for this, so we run late. Of course, if we
+             * don't spawn helper threads and we don't demote anything, there
+             * will never be helpers active so there's nothing to skip in
+             * software.
+             */
+            struct nir_opt_load_skip_helpers_options skip_helpers = {
+               .no_add_divergence = true
+            };
+            *track_helpers |=
+               JAY_NIR_PASS(nir_opt_load_skip_helpers, &skip_helpers);
+         }
+      }
    } else {
       jay_populate_prog_data(devinfo, nir, params->prog_data, params->key, NULL);
    }
-- 
2.53.0

