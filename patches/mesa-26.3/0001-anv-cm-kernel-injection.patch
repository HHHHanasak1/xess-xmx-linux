+/* ---- C-for-Metal kernel injection (xess-xmx-linux) ------------------------------------------------------------
+ * The igdext shim turns every C-for-Metal kernel XeSS submits into a placeholder D3D12 compute shader. The
+ * placeholder has the workgroup size (1, 1, ANV_CM_HASH_WG_Z) and stores ANV_CM_DUMMY_MAGIC and the kernel's 64-bit
+ * hash; the shim wrote the kernel's SPIR-V + options as <hash>.spv / <hash>.opt to $WINEPREFIX/drive_c/igdext_kernels.
+ * (The placeholders of older shims encode an id on the workgroup planes z = 7 / 11 / 13 instead, with the hash in the
+ * shim's map.txt and the files named dyn_<id>.) The kernel is compiled on first use (ANV_CM_HELPER, default
+ * <package>/tools/cm-compile.sh) into the per-user cache ~/.cache/xess-xmx/kernels/<hash>_<pci id>_<toolchain>.cmk.
+ * The placeholder's bindings only provide the pipeline layout; code, GRF count, SLM and payload come from the .cmk
+ * file (packed by anv_cm_pack() below from ocloc's zebin). Placeholders are never stored in the pipeline cache, so a
+ * changed kernel or a compile that failed once is picked up again on the next launch. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <string.h>
+#include <inttypes.h>
+#include <unistd.h>
+#include <errno.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <dirent.h>
+#include <dlfcn.h>
+#include "util/simple_mtx.h"
+#include <time.h>
+#include <spawn.h>
+#include "util/u_call_once.h"
+#include "util/u_atomic.h"
+
+#include "anv_private.h"
+#include "anv_shader.h"
+#include "anv_cm.h"
+#include "nir/nir.h"
+#include "util/ralloc.h"
+
+#define ANV_CM_DUMMY_MAGIC 0x584d5843u   /* stored by every placeholder shader of the shim */
+/* The placeholder shapes; tools/check_placeholders.py checks them against the shim's templates
+ * (shim/src/dll/placeholders.inc, written by tools/gen_placeholders.py). A kernel placeholder stores
+ * l(ANV_CM_DUMMY_MAGIC, hash & 0xffffffff, hash >> 32), the self-test l(ANV_CM_DUMMY_MAGIC, ANV_CM_CANARY_LO,
+ * ANV_CM_CANARY_HI). The self-test of an older shim is (1, 1, 17) with the magic alone. */
+#define ANV_CM_HASH_WG_Z 23
+#define ANV_CM_CANARY_WG_Z 19
+/* as floats a denormal and a signaling NaN: a translation step that flushed or canonicalized them would also alter
+ * some kernel hashes, so the self-test fails then instead */
+#define ANV_CM_CANARY_LO 0x00414e43u
+#define ANV_CM_CANARY_HI 0x7fa15952u
+#define ANV_CM_LEGACY_CANARY_WG_Z 17
+
+static struct anv_cm_env anv_cm_env_data;
+static util_once_flag anv_cm_env_once = UTIL_ONCE_FLAG_INIT;
+
+static void
+anv_cm_env_init(void)
+{
+   struct anv_cm_env *e = &anv_cm_env_data;
+   e->kernel_dir = getenv("ANV_CM_KERNEL_DIR");
+   e->debug = getenv("ANV_CM_DEBUG") != NULL;
+   const char *t = getenv("ANV_CM_TRACE");
+   e->trace = t ? (t[0] == '2' ? 2 : 1) : 0;
+}
+
+const struct anv_cm_env *
+anv_cm_env(void)
+{
+   util_call_once(&anv_cm_env_once, anv_cm_env_init);
+   return &anv_cm_env_data;
+}
+
+
+struct cmk_header {
+   char magic[4];               /* "CMK2" */
+   uint32_t code_size;
+   uint32_t grf_count;
+   uint32_t slm_size;
+   uint32_t barriers;           /* bit 31: kernel samples through a sampler */
+   uint32_t lws[3];
+   uint32_t cross_size;         /* bytes of cross-thread data (GRF multiple) */
+   uint32_t per_thread_size;    /* bytes of per-thread data (GRF multiple, packed local ids) */
+   uint8_t cross_data[128];
+   uint32_t heap_set;           /* descriptor set holding the vkd3d-style descriptor heap (~0 = find it) */
+   uint32_t heap_binding;       /* binding of the heap in that set */
+   uint32_t table_pc_base;      /* byte offset of the first descriptor-table offset in the push constants */
+   uint32_t nsurf;
+   uint32_t bti[24];            /* binding table index of surface k */
+   uint32_t table_idx[24];      /* descriptor table number (push constant slot) of surface k */
+   uint32_t elem[24];           /* element inside the table */
+};
+
+/* True if the shader is one of the shim's placeholders: tiny, and it stores ANV_CM_DUMMY_MAGIC. A real game shader
+ * that happens to use the same workgroup size is left alone. */
+static bool
+anv_cm_is_placeholder(nir_shader *nir)
+{
+   unsigned n = 0;
+   bool magic = false;
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (++n > 256)
+               return false;
+            if (instr->type != nir_instr_type_load_const)
+               continue;
+            nir_load_const_instr *lc = nir_instr_as_load_const(instr);
+            if (lc->def.bit_size != 32)
+               continue;
+            for (unsigned c = 0; c < lc->def.num_components; c++)
+               magic |= lc->value[c].u32 == ANV_CM_DUMMY_MAGIC;
+         }
+      }
+   }
+   return magic;
+}
+
+/* The ids of older shims: planes z = 7, 11, 13; inside a plane every (x, y) with x * y * z <= 1024, ordered by y
+ * then x (their tools/gen_dyn_dummies.py; the layout is fixed). */
+static const uint32_t anv_cm_dyn_planes[] = { 7, 11, 13 };
+static bool anv_cm_spv_dir(char *buf, size_t len, bool warn);
+static void anv_cm_mkdirs(const char *path);
+
+static int
+anv_cm_dyn_id(uint32_t wx, uint32_t wy, uint32_t wz)
+{
+   int base = 0;
+   for (unsigned p = 0; p < ARRAY_SIZE(anv_cm_dyn_planes); p++) {
+      const uint32_t z = anv_cm_dyn_planes[p], lim = 1024 / z;
+      if (wz == z) {
+         if (wx < 1 || wy < 1 || wx * wy > lim)
+            return -1;
+         int id = base;
+         for (uint32_t y = 1; y < wy; y++)
+            id += lim / y;
+         return id + (int)(wx - 1);
+      }
+      for (uint32_t y = 1; y <= lim; y++)
+         base += lim / y;
+   }
+   return -1;
+}
+
+static void
+anv_cm_mkdirs(const char *path)
+{
+   char tmp[512];
+   snprintf(tmp, sizeof(tmp), "%s", path);
+   for (char *p = tmp + 1; *p; p++) {
+      if (*p == '/') {
+         *p = 0;
+         mkdir(tmp, 0755);
+         *p = '/';
+      }
+   }
+   mkdir(tmp, 0755);
+}
+
+/* Folder with the shim's SPIR-V, map.txt and compile_failed.txt (the prefix's C:\igdext_kernels). warn: a
+ * placeholder was seen, so a missing folder is worth a line in the log. The retry at every vkCreateDevice passes
+ * false: processes outside Wine (gamescope, vulkaninfo) have neither variable and nothing to resolve. */
+static bool
+anv_cm_spv_dir(char *buf, size_t len, bool warn)
+{
+   const char *sdir = getenv("ANV_CM_SPV_DIR");
+   if (sdir) {
+      snprintf(buf, len, "%s", sdir);
+      return true;
+   }
+   const char *pfx = getenv("WINEPREFIX");
+   if (!pfx) {
+      static bool said;
+      if (warn && !said) {
+         fprintf(stderr, "ANV CM: neither ANV_CM_SPV_DIR nor WINEPREFIX is set: placeholders cannot be resolved\n");
+         said = true;
+      }
+      return false;
+   }
+   snprintf(buf, len, "%s/drive_c/igdext_kernels", pfx);
+   return true;
+}
+
+/* Compiler helper script: ANV_CM_HELPER, else <package>/tools/cm-compile.sh next to ANV_CM_KERNEL_DIR. */
+static bool
+anv_cm_helper_path(char *buf, size_t len)
+{
+   const struct anv_cm_env *env = anv_cm_env();
+   const char *helper = getenv("ANV_CM_HELPER");
+   if (helper && helper[0]) {
+      snprintf(buf, len, "%s", helper);
+      return true;
+   }
+   if (!env->kernel_dir || !env->kernel_dir[0]) {
+      static bool said;
+      if (!said)
+         fprintf(stderr, "ANV CM: neither ANV_CM_HELPER nor ANV_CM_KERNEL_DIR is set: kernels cannot be compiled\n");
+      said = true;
+      return false;
+   }
+   snprintf(buf, len, "%s/../tools/cm-compile.sh", env->kernel_dir);
+   return true;
+}
+
+/* Whole file, NUL-terminated (not counted in *size); NULL if it cannot be read. */
+static uint8_t *
+anv_cm_read_file(const char *path, size_t *size)
+{
+   FILE *f = fopen(path, "rb");
+   if (!f)
+      return NULL;
+   uint8_t *buf = NULL;
+   size_t n = 0, cap = 0;
+   for (;;) {
+      if (cap - n < 65536) {
+         uint8_t *nb = realloc(buf, cap + 65536 + 1);
+         if (!nb) {
+            free(buf);
+            fclose(f);
+            return NULL;
+         }
+         buf = nb;
+         cap += 65536;
+      }
+      const size_t got = fread(buf + n, 1, cap - n, f);
+      n += got;
+      if (got == 0)
+         break;
+   }
+   const bool err = ferror(f);
+   fclose(f);
+   if (err) {
+      free(buf);
+      return NULL;
+   }
+   buf[n] = 0;
+   *size = n;
+   return buf;
+}
+
+/* Version of the .cmk packer below; part of the toolchain generation, so a change of the format it writes leads to
+ * recompiles. */
+#define ANV_CM_PACKER_VERSION "cmk2-c1"
+
+/* Generation of the compiler toolchain: FNV-1a over the ocloc and IGC library file names in <package>/igc, the
+ * contents of the helper scripts and the packer version. Part of every cached kernel's name, so an IGC/ocloc update,
+ * a changed compile script or a new .cmk format invalidates them. */
+static uint32_t
+anv_cm_toolchain_gen(void)
+{
+   static uint32_t gen;
+   static bool done;
+   if (done)
+      return gen;
+   uint32_t h = 2166136261u;
+   char helper[600], dir[700];
+   if (anv_cm_helper_path(helper, sizeof(helper))) {
+      char *slash = strrchr(helper, '/');
+      if (slash)
+         *slash = 0;                            /* <package>/tools */
+      const char *sub[] = { "/../igc/neo/bin", "/../igc/igc/local/lib" };
+      for (unsigned i = 0; i < ARRAY_SIZE(sub); i++) {
+         snprintf(dir, sizeof(dir), "%s%s", helper, sub[i]);
+         DIR *d = opendir(dir);
+         if (!d)
+            continue;
+         struct dirent *e;
+         while ((e = readdir(d))) {
+            if (strncmp(e->d_name, "ocloc", 5) != 0 && strncmp(e->d_name, "libigc.so.", 10) != 0)
+               continue;
+            for (const char *c = e->d_name; *c; c++)
+               h = (h ^ (uint8_t)*c) * 16777619u;
+         }
+         closedir(d);
+      }
+      /* cm-compile.sh runs ocloc; cmk_pack.py packs when the script is one of an older package, which ignores
+       * CM_OUT_DIR (see anv_cm_compile) */
+      const char *scripts[] = { "/cmk_pack.py", "/cm-compile.sh" };
+      for (unsigned i = 0; i < ARRAY_SIZE(scripts); i++) {
+         snprintf(dir, sizeof(dir), "%s%s", helper, scripts[i]);
+         size_t size;
+         uint8_t *data = anv_cm_read_file(dir, &size);
+         if (!data)
+            continue;
+         for (size_t k = 0; k < size; k++)
+            h = (h ^ data[k]) * 16777619u;
+         free(data);
+         h = (h ^ (uint32_t)size) * 16777619u;   /* file boundary */
+      }
+   }
+   for (const char *c = ANV_CM_PACKER_VERSION; *c; c++)
+      h = (h ^ (uint8_t)*c) * 16777619u;
+   /* a compile-device override changes every kernel */
+   const char *cmdev = getenv("CM_DEVICE");
+   for (const char *c = cmdev ? cmdev : ""; *c; c++)
+      h = (h ^ (uint8_t)*c) * 16777619u;
+   gen = h;
+   done = true;
+   return gen;
+}
+
+/* Per-user kernel cache: ~/.cache/xess-xmx/kernels (XDG_CACHE_HOME honoured); fills the folder and the file name. */
+static void
+anv_cm_cache_path(struct anv_device *device, const char *hash, char *dir, size_t dirlen, char *path, size_t pathlen)
+{
+   const char *xdg = getenv("XDG_CACHE_HOME");
+   if (xdg && xdg[0])
+      snprintf(dir, dirlen, "%s/xess-xmx/kernels", xdg);
+   else
+      snprintf(dir, dirlen, "%s/.cache/xess-xmx/kernels", getenv("HOME") ? getenv("HOME") : "/tmp");
+   snprintf(path, pathlen, "%s/%s_%04x_%08x.cmk", dir, hash, device->info->pci_device_id, anv_cm_toolchain_gen());
+}
+
+/* ---- .cmk packer ------------------------------------------------------------------------------------------------
+ * A C port of tools/cmk_pack.py as tools/cm-compile.sh calls it (kernel "auto", --heap auto --surf auto, group count
+ * 1,1,1): one kernel of the zebin ocloc wrote is packed into the CMK2 file anv_cm_kernel_replace() reads. The
+ * .ze_info YAML is not parsed but matched the way the script's regular expressions match it (Python's \s, \d and \w
+ * on the section decoded as Latin-1), and every input the script rejects is rejected here, so that both write the
+ * same bytes. Packing in the driver saves a python3 start per kernel. */
+struct anv_cm_sv {
+   const char *p;
+   size_t n;
+};
+
+#define ANV_CM_NPOS SIZE_MAX
+
+static bool
+anv_cm_py_space(uint8_t c)
+{
+   return (c >= 0x09 && c <= 0x0d) || (c >= 0x1c && c <= 0x20) || c == 0x85 || c == 0xa0;
+}
+
+static bool
+anv_cm_py_word(uint8_t c)   /* str.isalnum() or '_' */
+{
+   return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_' ||
+          c == 0xaa || c == 0xb2 || c == 0xb3 || c == 0xb5 || c == 0xb9 || c == 0xba || (c >= 0xbc && c <= 0xbe) ||
+          (c >= 0xc0 && c != 0xd7 && c != 0xf7);
+}
+
+static size_t
+anv_cm_sv_find(struct anv_cm_sv s, size_t from, const char *sub)
+{
+   const size_t k = strlen(sub);
+   for (size_t i = from; i <= s.n && s.n - i >= k; i++)
+      if (memcmp(s.p + i, sub, k) == 0)
+         return i;
+   return ANV_CM_NPOS;
+}
+
+/* str.split(sep)[1], if sep occurs */
+static bool
+anv_cm_sv_split1(struct anv_cm_sv s, const char *sep, struct anv_cm_sv *out)
+{
+   const size_t a = anv_cm_sv_find(s, 0, sep);
+   if (a == ANV_CM_NPOS)
+      return false;
+   const size_t from = a + strlen(sep), b = anv_cm_sv_find(s, from, sep);
+   *out = (struct anv_cm_sv) { s.p + from, (b == ANV_CM_NPOS ? s.n : b) - from };
+   return true;
+}
+
+/* str.split(sep)[0] */
+static struct anv_cm_sv
+anv_cm_sv_split0(struct anv_cm_sv s, const char *sep)
+{
+   const size_t a = anv_cm_sv_find(s, 0, sep);
+   return (struct anv_cm_sv) { s.p, a == ANV_CM_NPOS ? s.n : a };
+}
+
+/* the pattern pieces \s+, a literal, (\d+) and (\w+) at *i; *i moves past them on a match */
+static bool
+anv_cm_re_ws(struct anv_cm_sv s, size_t *i)
+{
+   size_t j = *i;
+   while (j < s.n && anv_cm_py_space(s.p[j]))
+      j++;
+   if (j == *i)
+      return false;
+   *i = j;
+   return true;
+}
+
+static bool
+anv_cm_re_lit(struct anv_cm_sv s, size_t *i, const char *lit)
+{
+   const size_t k = strlen(lit);
+   if (*i > s.n || s.n - *i < k || memcmp(s.p + *i, lit, k) != 0)
+      return false;
+   *i += k;
+   return true;
+}
+
+static bool
+anv_cm_re_num(struct anv_cm_sv s, size_t *i, uint64_t *v)   /* saturates; such values fail later, as in Python */
+{
+   size_t j = *i;
+   uint64_t x = 0;
+   while (j < s.n && s.p[j] >= '0' && s.p[j] <= '9') {
+      const unsigned d = s.p[j] - '0';
+      x = x > (UINT64_MAX - d) / 10 ? UINT64_MAX : x * 10 + d;
+      j++;
+   }
+   if (j == *i)
+      return false;
+   *i = j;
+   *v = x;
+   return true;
+}
+
+static bool
+anv_cm_re_word(struct anv_cm_sv s, size_t *i, struct anv_cm_sv *w)
+{
+   size_t j = *i;
+   while (j < s.n && anv_cm_py_word(s.p[j]))
+      j++;
+   if (j == *i)
+      return false;
+   *w = (struct anv_cm_sv) { s.p + *i, j - *i };
+   *i = j;
+   return true;
+}
+
+static bool
+anv_cm_sv_eq(struct anv_cm_sv s, const char *lit)
+{
+   return s.n == strlen(lit) && memcmp(s.p, lit, s.n) == 0;
+}
+
+/* re.search(r"\n\s+" + key + r":\s+(\d+)", s) */
+static bool
+anv_cm_re_geti(struct anv_cm_sv s, const char *key, uint64_t *v)
+{
+   for (size_t i = 0; i < s.n; i++) {
+      size_t j = i + 1;
+      if (s.p[i] == '\n' && anv_cm_re_ws(s, &j) && anv_cm_re_lit(s, &j, key) && anv_cm_re_lit(s, &j, ":") &&
+          anv_cm_re_ws(s, &j) && anv_cm_re_num(s, &j, v))
+         return true;
+   }
+   return false;
+}
+
+/* re.finditer(r"- arg_type:\s+(\w+)\s+offset:\s+(\d+)\s+size:\s+(\d+)", s), one match per call from *pos */
+static bool
+anv_cm_re_next_arg(struct anv_cm_sv s, size_t *pos, struct anv_cm_sv *type, uint64_t *off, uint64_t *size)
+{
+   for (size_t i = anv_cm_sv_find(s, *pos, "- arg_type:"); i != ANV_CM_NPOS; i = anv_cm_sv_find(s, i + 1, "- arg_type:")) {
+      size_t j = i + strlen("- arg_type:");
+      if (anv_cm_re_ws(s, &j) && anv_cm_re_word(s, &j, type) && anv_cm_re_ws(s, &j) &&
+          anv_cm_re_lit(s, &j, "offset:") && anv_cm_re_ws(s, &j) && anv_cm_re_num(s, &j, off) && anv_cm_re_ws(s, &j) &&
+          anv_cm_re_lit(s, &j, "size:") && anv_cm_re_ws(s, &j) && anv_cm_re_num(s, &j, size)) {
+         *pos = j;
+         return true;
+      }
+   }
+   return false;
+}
+
+/* re.finditer(r"bti_value:\s+(\d+)\s+arg_index:\s+(\d+)", s), one match per call from *pos */
+static bool
+anv_cm_re_next_bti(struct anv_cm_sv s, size_t *pos, uint64_t *bti, uint64_t *arg)
+{
+   for (size_t i = anv_cm_sv_find(s, *pos, "bti_value:"); i != ANV_CM_NPOS; i = anv_cm_sv_find(s, i + 1, "bti_value:")) {
+      size_t j = i + strlen("bti_value:");
+      if (anv_cm_re_ws(s, &j) && anv_cm_re_num(s, &j, bti) && anv_cm_re_ws(s, &j) &&
+          anv_cm_re_lit(s, &j, "arg_index:") && anv_cm_re_ws(s, &j) && anv_cm_re_num(s, &j, arg)) {
+         *pos = j;
+         return true;
+      }
+   }
+   return false;
+}
+
+/* bytes.decode() (strict UTF-8) succeeds */
+static bool
+anv_cm_utf8_ok(const uint8_t *s, size_t n)
+{
+   for (size_t i = 0; i < n;) {
+      const uint8_t c = s[i];
+      unsigned len, cp;
+      if (c < 0x80) {
+         i++;
+         continue;
+      } else if (c >= 0xc2 && c <= 0xdf) {
+         len = 2, cp = c & 0x1f;
+      } else if (c >= 0xe0 && c <= 0xef) {
+         len = 3, cp = c & 0x0f;
+      } else if (c >= 0xf0 && c <= 0xf4) {
+         len = 4, cp = c & 0x07;
+      } else {
+         return false;
+      }
+      if (n - i < len)
+         return false;
+      for (unsigned k = 1; k < len; k++) {
+         if ((s[i + k] & 0xc0) != 0x80)
+            return false;
+         cp = cp << 6 | (s[i + k] & 0x3f);
+      }
+      if ((len == 3 && (cp < 0x800 || (cp >= 0xd800 && cp <= 0xdfff))) || (len == 4 && (cp < 0x10000 || cp > 0x10ffff)))
+         return false;
+      i += len;
+   }
+   return true;
+}
+
+static uint64_t
+anv_cm_rd_le(const uint8_t *p, unsigned bytes)
+{
+   uint64_t v = 0;
+   for (unsigned i = 0; i < bytes; i++)
+      v |= (uint64_t)p[i] << (8 * i);
+   return v;
+}
+
+static void
+anv_cm_wr32(uint8_t *p, uint32_t v)
+{
+   for (unsigned i = 0; i < 4; i++)
+      p[i] = v >> (8 * i);
+}
+
+/* d[off:off + size] with Python's clamping */
+static struct anv_cm_sv
+anv_cm_slice(const uint8_t *d, size_t n, uint64_t off, uint64_t size)
+{
+   const uint64_t a = MIN2(off, (uint64_t)n);
+   const uint64_t b = size > n - a ? n : a + size;
+   return (struct anv_cm_sv) { (const char *)d + a, b - a };
+}
+
+#define ANV_CM_HEADER_SIZE 472
+
+/* Packs zebin d (n bytes) for the work-group size lws into a malloc'd CMK2 image; NULL and a reason on failure. */
+static uint8_t *
+anv_cm_pack(const uint8_t *d, size_t n, const uint64_t lws[3], uint32_t grf_bytes, size_t *out_size,
+            char *err, size_t errlen)
+{
+#define PACK_FAIL(...) do { snprintf(err, errlen, __VA_ARGS__); goto fail; } while (0)
+   char *s = NULL;
+   uint8_t *out = NULL;
+   /* the ELF section headers */
+   if (n < 4 || memcmp(d, "\x7f" "ELF", 4) != 0)
+      PACK_FAIL("not an ELF file");
+   if (n < 0x40)
+      PACK_FAIL("truncated ELF header");
+   const uint64_t shoff = anv_cm_rd_le(d + 0x28, 8);
+   const unsigned shentsize = anv_cm_rd_le(d + 0x3a, 2), shnum = anv_cm_rd_le(d + 0x3c, 2),
+                  shstrndx = anv_cm_rd_le(d + 0x3e, 2);
+   if (shstrndx >= shnum)
+      PACK_FAIL("no section name table");
+   for (unsigned k = 0; k < shnum; k++) {
+      const uint64_t o = shoff + (uint64_t)k * shentsize;
+      if (o < shoff || o > n || n - o < 40)
+         PACK_FAIL("section header %u out of the file", k);
+   }
+#define SEC(k, field) anv_cm_rd_le(d + shoff + (uint64_t)(k) * shentsize + (field), (field) < 8 ? 4 : 8)
+   const uint64_t stroff = SEC(shstrndx, 24);
+   /* every section name must be readable (the script decodes them all); the kernel is the first .text.* that is
+    * not .text.Intel_*, its code and .ze_info the last section of that name */
+   int text = -1, zeinfo = -1;
+   struct anv_cm_sv kname = { NULL, 0 };
+   for (unsigned k = 0; k < shnum; k++) {
+      const uint64_t no = stroff + SEC(k, 0);
+      if (no < stroff || no >= n)
+         PACK_FAIL("section name %u out of the file", k);
+      const uint8_t *nm = d + no, *end = memchr(nm, 0, n - no);
+      if (!end)
+         PACK_FAIL("section name %u not terminated", k);
+      const size_t len = end - nm;
+      if (!anv_cm_utf8_ok(nm, len))
+         PACK_FAIL("section name %u is not UTF-8", k);
+      if (!kname.p && len >= 6 && memcmp(nm, ".text.", 6) == 0 && !(len >= 12 && memcmp(nm, ".text.Intel_", 12) == 0))
+         kname = (struct anv_cm_sv) { (const char *)nm + 6, len - 6 };
+      if (len == 8 && memcmp(nm, ".ze_info", 8) == 0)
+         zeinfo = k;
+   }
+   if (!kname.p)
+      PACK_FAIL("no kernel in the zebin");
+   for (unsigned k = 0; k < shnum; k++) {
+      const uint8_t *nm = d + stroff + SEC(k, 0);
+      if (strlen((const char *)nm) == kname.n + 6 && memcmp(nm, ".text.", 6) == 0 && memcmp(nm + 6, kname.p, kname.n) == 0)
+         text = k;
+   }
+   if (zeinfo < 0)
+      PACK_FAIL("no .ze_info");
+   for (size_t i = 0; i < kname.n; i++)
+      if ((uint8_t)kname.p[i] >= 0x80)
+         PACK_FAIL("kernel name is not ASCII");   /* the script's Latin-1/UTF-8 comparison could never match it */
+   const struct anv_cm_sv code = anv_cm_slice(d, n, SEC(text, 24), SEC(text, 32));
+   const struct anv_cm_sv info = anv_cm_slice(d, n, SEC(zeinfo, 24), SEC(zeinfo, 32));
+#undef SEC
+
+   /* the kernel's block: re.split(r"\n  - name:\s+", "\n" + info[info.index("kernels:"):]), the first piece that
+    * starts with the kernel's name */
+   const size_t ki = anv_cm_sv_find(info, 0, "kernels:");
+   if (ki == ANV_CM_NPOS)
+      PACK_FAIL("no kernels in .ze_info");
+   s = malloc(info.n - ki + 1);
+   if (!s)
+      PACK_FAIL("out of memory");
+   s[0] = '\n';
+   memcpy(s + 1, info.p + ki, info.n - ki);
+   const struct anv_cm_sv all = { s, info.n - ki + 1 };
+   struct anv_cm_sv blk = { NULL, 0 };
+   for (size_t from = 0;;) {
+      size_t ms = ANV_CM_NPOS, me = 0;
+      for (size_t i = anv_cm_sv_find(all, from, "\n  - name:"); i != ANV_CM_NPOS; i = anv_cm_sv_find(all, i + 1, "\n  - name:")) {
+         size_t j = i + strlen("\n  - name:");
+         if (anv_cm_re_ws(all, &j)) {
+            ms = i, me = j;
+            break;
+         }
+      }
+      const struct anv_cm_sv piece = { all.p + from, (ms == ANV_CM_NPOS ? all.n : ms) - from };
+      if (piece.n >= kname.n && memcmp(piece.p, kname.p, kname.n) == 0) {
+         blk = piece;
+         break;
+      }
+      if (ms == ANV_CM_NPOS)
+         break;
+      from = me;
+   }
+   if (!blk.p)
+      PACK_FAIL("kernel %.*s not in .ze_info", (int)kname.n, kname.p);
+   /* the driver gives kernels no scratch or private memory (as the script) */
+   if (anv_cm_sv_find(blk, 0, "per_thread_memory_buffers") != ANV_CM_NPOS)
+      PACK_FAIL("kernel %.*s needs scratch or private memory, which the driver does not provide", (int)kname.n, kname.p);
+   uint64_t grf = 128, slm = 0, barriers = 0;
+   anv_cm_re_geti(blk, "grf_count", &grf);
+   anv_cm_re_geti(blk, "slm_size", &slm);
+   anv_cm_re_geti(blk, "barrier_count", &barriers);
+   for (size_t i = anv_cm_sv_find(blk, 0, "addrspace:"); i != ANV_CM_NPOS; i = anv_cm_sv_find(blk, i + 1, "addrspace:")) {
+      size_t j = i + strlen("addrspace:");
+      if (anv_cm_re_ws(blk, &j) && anv_cm_re_lit(blk, &j, "sampler")) {
+         barriers |= 0x80000000u;
+         break;
+      }
+   }
+   for (unsigned k = 0; k < 3; k++)
+      if (lws[k] > UINT32_MAX)
+         PACK_FAIL("work-group size out of range");
+
+   /* cross-thread data */
+   uint8_t cross[128] = { 0 };
+   uint64_t cross_size = 0;
+   struct anv_cm_sv pay = { NULL, 0 }, typ;
+   if (anv_cm_sv_split1(blk, "payload_arguments:", &pay))
+      pay = anv_cm_sv_split0(pay, "per_thread_payload_arguments:");
+   uint64_t off, size;
+   for (size_t pos = 0; pay.p && anv_cm_re_next_arg(pay, &pos, &typ, &off, &size);) {
+      if (size == 0)
+         continue;
+      cross_size = MAX2(cross_size, off > UINT64_MAX - size ? UINT64_MAX : off + size);
+      if (anv_cm_sv_eq(typ, "local_size") || anv_cm_sv_eq(typ, "enqueued_local_size") || anv_cm_sv_eq(typ, "group_count")) {
+         if (off > sizeof(cross) - 12)
+            PACK_FAIL("cross-thread argument at %" PRIu64 " out of range", off);
+         const bool gc = anv_cm_sv_eq(typ, "group_count");   /* written once per shader: 1,1,1 */
+         for (unsigned k = 0; k < 3; k++)
+            anv_cm_wr32(cross + off + 4 * k, gc ? 1 : (uint32_t)lws[k]);
+      } else if (anv_cm_sv_eq(typ, "work_dimensions")) {
+         if (off > sizeof(cross) - 4)
+            PACK_FAIL("cross-thread argument at %" PRIu64 " out of range", off);
+         anv_cm_wr32(cross + off, lws[2] > 1 ? 3 : (lws[1] > 1 ? 2 : 1));
+      }
+   }
+   cross_size = cross_size > sizeof(cross) ? UINT64_MAX : (cross_size + 31) / 32 * 32;
+   if (cross_size > sizeof(cross))
+      PACK_FAIL("cross-thread data larger than 128 bytes");
+
+   /* per-thread data: one GRF per thread */
+   uint64_t per_size = 0;
+   struct anv_cm_sv per;
+   if (anv_cm_sv_split1(blk, "per_thread_payload_arguments:", &per)) {
+      for (size_t pos = 0; anv_cm_re_next_arg(per, &pos, &typ, &off, &size);)
+         per_size = MAX2(per_size, off > UINT64_MAX - size ? UINT64_MAX : off + size);
+   }
+   if (per_size <= UINT32_MAX)
+      per_size = (per_size + grf_bytes - 1) / grf_bytes * grf_bytes;
+   if (per_size > UINT32_MAX)
+      PACK_FAIL("per-thread data out of range");
+
+   /* surfaces in argument order; surface k is the k-th descriptor table */
+   uint64_t bti_arg[24], bti_val[24], b, a;
+   unsigned ns = 0;
+   struct anv_cm_sv bt;
+   if (anv_cm_sv_split1(blk, "binding_table_indices:", &bt)) {
+      for (size_t pos = 0; anv_cm_re_next_bti(bt, &pos, &b, &a);) {
+         unsigned k = 0;
+         while (k < ns && bti_arg[k] != a)
+            k++;
+         if (k == ns) {
+            if (ns == ARRAY_SIZE(bti_arg))
+               PACK_FAIL("more than 24 surfaces");
+            /* sorted by argument index */
+            while (k > 0 && bti_arg[k - 1] > a) {
+               bti_arg[k] = bti_arg[k - 1];
+               bti_val[k] = bti_val[k - 1];
+               k--;
+            }
+            bti_arg[k] = a;
+            ns++;
+         }
+         bti_val[k] = b;
+      }
+   }
+   if (grf > UINT32_MAX || slm > UINT32_MAX || barriers > UINT32_MAX || code.n > UINT32_MAX)
+      PACK_FAIL("header value out of range");
+   for (unsigned k = 0; k < ns; k++)
+      if (bti_val[k] > UINT32_MAX)
+         PACK_FAIL("binding table index out of range");
+
+   *out_size = ANV_CM_HEADER_SIZE + code.n;
+   out = calloc(1, *out_size);
+   if (!out)
+      PACK_FAIL("out of memory");
+   memcpy(out, "CMK2", 4);
+   const uint64_t hdr[9] = { code.n, grf, slm, barriers, lws[0], lws[1], lws[2], cross_size, per_size };
+   for (unsigned k = 0; k < 9; k++)
+      anv_cm_wr32(out + 4 + 4 * k, hdr[k]);
+   memcpy(out + 40, cross, sizeof(cross));
+   anv_cm_wr32(out + 168, 0xffffffffu);   /* heap set: found at pipeline creation; binding and table base 0 */
+   anv_cm_wr32(out + 180, ns);
+   for (unsigned k = 0; k < ns; k++) {
+      anv_cm_wr32(out + 184 + 4 * k, bti_val[k]);
+      anv_cm_wr32(out + 280 + 4 * k, k);    /* table k, element 0 */
+   }
+   memcpy(out + ANV_CM_HEADER_SIZE, code.p, code.n);
+   free(s);
+   return out;
+fail:
+   free(s);
+   free(out);
+   return NULL;
+#undef PACK_FAIL
+}
+
+/* The work-group size in the compile options, read as tools/cm-compile.sh reads it (NUL bytes dropped, the first
+ * "LWS_SIZE_X=<n> -DLWS_SIZE_Y=<n> -DLWS_SIZE_Z=<n>"), else 1,1,1. */
+static void
+anv_cm_opt_lws(const uint8_t *opt, size_t n, uint64_t lws[3])
+{
+   lws[0] = lws[1] = lws[2] = 1;
+   char *t = malloc(n + 1);
+   if (!t)
+      return;
+   size_t m = 0;
+   for (size_t i = 0; i < n; i++)
+      if (opt[i])
+         t[m++] = opt[i];
+   const struct anv_cm_sv s = { t, m };
+   for (size_t i = anv_cm_sv_find(s, 0, "LWS_SIZE_X="); i != ANV_CM_NPOS; i = anv_cm_sv_find(s, i + 1, "LWS_SIZE_X=")) {
+      size_t j = i + strlen("LWS_SIZE_X=");
+      uint64_t v[3];
+      if (anv_cm_re_num(s, &j, &v[0]) && anv_cm_re_lit(s, &j, " -DLWS_SIZE_Y=") && anv_cm_re_num(s, &j, &v[1]) &&
+          anv_cm_re_lit(s, &j, " -DLWS_SIZE_Z=") && anv_cm_re_num(s, &j, &v[2])) {
+         memcpy(lws, v, sizeof(v));
+         break;
+      }
+   }
+   free(t);
+}
+/* ---- end of the .cmk packer ---- */
+
+/* Appends a line to the compile log: CM_LOG, else ~/.cache/xess-xmx/compile.log (as tools/cm-compile.sh) */
+static void PRINTFLIKE(1, 2)
+anv_cm_log(const char *fmt, ...)
+{
+   char path[600];
+   const char *log = getenv("CM_LOG"), *xdg = getenv("XDG_CACHE_HOME");
+   if (log && log[0])
+      snprintf(path, sizeof(path), "%s", log);
+   else if (xdg && xdg[0])
+      snprintf(path, sizeof(path), "%s/xess-xmx/compile.log", xdg);
+   else
+      snprintf(path, sizeof(path), "%s/.cache/xess-xmx/compile.log", getenv("HOME") ? getenv("HOME") : "/tmp");
+   FILE *f = fopen(path, "a");
+   if (!f)
+      return;
+   va_list ap;
+   va_start(ap, fmt);
+   vfprintf(f, fmt, ap);
+   va_end(ap);
+   fclose(f);
+}
+
+/* Packs the zebin in outdir (k_*.bin, as ocloc names it) with the work-group size of the options file opt into
+ * path, through a private temporary name (two threads may compile the same kernel). */
+static bool
+anv_cm_pack_dir(struct anv_device *device, const char *outdir, const char *opt, const char *path,
+                uint64_t lws[3], char *err, size_t errlen)
+{
+   char bin[700] = "";
+   DIR *dir = opendir(outdir);
+   if (dir) {
+      struct dirent *e;
+      char best[256] = "";
+      while ((e = readdir(dir))) {
+         const size_t len = strlen(e->d_name);
+         if (len > 6 && strncmp(e->d_name, "k_", 2) == 0 && strcmp(e->d_name + len - 4, ".bin") == 0 &&
+             (!best[0] || strcmp(e->d_name, best) < 0))
+            snprintf(best, sizeof(best), "%s", e->d_name);
+      }
+      closedir(dir);
+      if (best[0])
+         snprintf(bin, sizeof(bin), "%s/%s", outdir, best);
+   }
+   if (!bin[0]) {
+      snprintf(err, errlen, "no zebin");
+      return false;
+   }
+   size_t zn, on;
+   uint8_t *z = anv_cm_read_file(bin, &zn), *o = anv_cm_read_file(opt, &on);
+   bool ok = false;
+   if (z && o) {
+      anv_cm_opt_lws(o, on, lws);
+      size_t cn;
+      uint8_t *cmk = anv_cm_pack(z, zn, lws, device->info->grf_size, &cn, err, errlen);
+      if (cmk) {
+         static int seq;
+         char tmp[800];
+         snprintf(tmp, sizeof(tmp), "%s.%d.%d.tmp", path, (int)getpid(), p_atomic_inc_return(&seq));
+         FILE *f = fopen(tmp, "wb");
+         ok = f && fwrite(cmk, 1, cn, f) == cn;
+         if (f && fclose(f) != 0)
+            ok = false;
+         if (ok && rename(tmp, path) != 0)
+            ok = false;
+         if (!ok) {
+            snprintf(err, errlen, "cannot write %s: %s", tmp, strerror(errno));
+            unlink(tmp);
+         }
+         free(cmk);
+      }
+   } else {
+      snprintf(err, errlen, "cannot read %s", z ? opt : bin);
+   }
+   free(z);
+   free(o);
+   return ok;
+}
+
+/* Runs the compiler helper for <name>.spv (the kernel's hash, or dyn_<id> from an older shim) and packs its output
+ * into path; true when the packed kernel exists afterwards. */
+static bool
+anv_cm_compile(struct anv_device *device, const char *sdir, const char *name, const char *hash, const char *cdir,
+               const char *path)
+{
+   char spv[600], opt[600];
+   snprintf(spv, sizeof(spv), "%s/%s.spv", sdir, name);
+   snprintf(opt, sizeof(opt), "%s/%s.opt", sdir, name);
+   if (access(spv, R_OK) != 0 || access(opt, R_OK) != 0) {
+      fprintf(stderr, "ANV CM: kernel %s: no %s\n", hash, spv);
+      return false;
+   }
+   anv_cm_mkdirs(cdir);
+   char helper[600];
+   if (!anv_cm_helper_path(helper, sizeof(helper)))
+      return false;
+   /* ocloc writes into a private folder, the driver packs the result. The helper of an older package ignores
+    * CM_OUT_DIR and packs into path itself, which is accepted as well. */
+   char outdir[600];
+   const char *tmpdir = getenv("TMPDIR");
+   snprintf(outdir, sizeof(outdir), "%s/cmk.XXXXXX", tmpdir && tmpdir[0] ? tmpdir : "/tmp");
+   if (!mkdtemp(outdir)) {
+      fprintf(stderr, "ANV CM: kernel %s: no temporary folder %s: %s\n", hash, outdir, strerror(errno));
+      return false;
+   }
+   /* posix_spawn instead of system(): no fork of the (multi-GB) game process for every kernel */
+   char pci[32], grf[32], out[640];
+   snprintf(pci, sizeof(pci), "CM_PCI_ID=0x%04x", device->info->pci_device_id);
+   snprintf(grf, sizeof(grf), "CM_GRF_BYTES=%u", (unsigned)device->info->grf_size);
+   snprintf(out, sizeof(out), "CM_OUT_DIR=%s", outdir);
+   extern char **environ;
+   unsigned nenv = 0;
+   while (environ[nenv])
+      nenv++;
+   char **envp = calloc(nenv + 4, sizeof(char *));
+   if (!envp) {
+      rmdir(outdir);
+      return false;
+   }
+   unsigned ne = 0;
+   for (unsigned e = 0; e < nenv; e++)
+      if (strncmp(environ[e], "CM_PCI_ID=", 10) != 0 && strncmp(environ[e], "CM_GRF_BYTES=", 13) != 0 &&
+          strncmp(environ[e], "CM_OUT_DIR=", 11) != 0)
+         envp[ne++] = environ[e];
+   envp[ne++] = pci;
+   envp[ne++] = grf;
+   envp[ne++] = out;
+   char *argv[] = { (char *)"/bin/sh", (char *)helper, spv, opt, (char *)path, NULL };
+   fprintf(stderr, "ANV CM: compiling kernel %s (%s.spv)\n", hash, name);
+   struct timespec t0, t1;
+   clock_gettime(CLOCK_MONOTONIC, &t0);
+   pid_t pid;
+   int rc = posix_spawn(&pid, "/bin/sh", NULL, NULL, argv, envp);
+   free(envp);
+   if (rc == 0) {
+      int status = 0;
+      while (waitpid(pid, &status, 0) < 0 && errno == EINTR)
+         ;
+      rc = WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+   }
+   bool ok = false;
+   char err[300] = "";
+   if (rc == 0) {
+      uint64_t lws[3];
+      if (anv_cm_pack_dir(device, outdir, opt, path, lws, err, sizeof(err))) {
+         clock_gettime(CLOCK_MONOTONIC, &t1);
+         /* device and flags as the helper chose them (CM_OUT_DIR/info) */
+         char info[700], dev[64] = "?", flags[512] = "";
+         snprintf(info, sizeof(info), "%s/info", outdir);
+         FILE *fi = fopen(info, "r");
+         if (fi) {
+            if (!fgets(dev, sizeof(dev), fi))
+               snprintf(dev, sizeof(dev), "?");
+            if (!fgets(flags, sizeof(flags), fi))
+               flags[0] = 0;
+            dev[strcspn(dev, "\n")] = 0;
+            flags[strcspn(flags, "\n")] = 0;
+            fclose(fi);
+         }
+         const char *ob = strrchr(path, '/'), *sb = strrchr(spv, '/');
+         anv_cm_log("cm-compile ok: %s from %s device %s lws %" PRIu64 "x%" PRIu64 "x%" PRIu64 " flags [%s] in %.1f s\n",
+                    ob ? ob + 1 : path, sb ? sb + 1 : spv, dev, lws[0], lws[1], lws[2], flags,
+                    (t1.tv_sec - t0.tv_sec) + (t1.tv_nsec - t0.tv_nsec) / 1e9);
+         ok = true;
+      } else if (access(path, R_OK) == 0) {
+         ok = true;   /* packed by the helper of an older package */
+      } else {
+         anv_cm_log("cm-compile PACK FAILED: %s: %s\n", spv, err);
+      }
+   }
+   DIR *dir = opendir(outdir);
+   if (dir) {
+      struct dirent *e;
+      char f[900];
+      while ((e = readdir(dir))) {
+         if (strcmp(e->d_name, ".") != 0 && strcmp(e->d_name, "..") != 0) {
+            snprintf(f, sizeof(f), "%s/%s", outdir, e->d_name);
+            unlink(f);
+         }
+      }
+      closedir(dir);
+   }
+   rmdir(outdir);
+   if (!ok) {
+      fprintf(stderr, "ANV CM: kernel %s: compile failed (rc %d%s%s)\n", hash, rc, err[0] ? ", " : "", err);
+      return false;
+   }
+   return true;
+}
+
+/* The packed kernel of a placeholder, compiled from <sdir>/<name>.spv on a cache miss. name is the kernel's hash
+ * (placeholders that carry it) or dyn_<id> (the id placeholders of an older shim, id >= 0). */
+static bool
+anv_cm_kernel_path(struct anv_device *device, const char *sdir, int id, const char *name, const char *hash,
+                   char *path, size_t pathlen)
+{
+   char cdir[512];
+   anv_cm_cache_path(device, hash, cdir, sizeof(cdir), path, pathlen);
+   if (access(path, R_OK) == 0)
+      return true;
+   /* a kernel that failed to compile in this process is not tried again here (each recreation of the placeholder
+    * would spawn the compiler once more and append another marker line); the next launch retries it */
+   static char failed[64][32];
+   static unsigned nfailed;
+   static simple_mtx_t failed_mtx = SIMPLE_MTX_INITIALIZER;
+   simple_mtx_lock(&failed_mtx);
+   bool known = false;
+   for (unsigned k = 0; k < nfailed && !known; k++)
+      known = strcmp(failed[k], hash) == 0;
+   simple_mtx_unlock(&failed_mtx);
+   if (known)
+      return false;
+   if (anv_cm_compile(device, sdir, name, hash, cdir, path))
+      return true;
+   simple_mtx_lock(&failed_mtx);
+   if (nfailed < ARRAY_SIZE(failed))
+      snprintf(failed[nfailed++], sizeof(failed[0]), "%s", hash);
+   simple_mtx_unlock(&failed_mtx);
+   /* tells the shim to fall back to XeSS' DP4a path on the next launch; retried by anv_cm_retry_failed(). The line is
+    * "<id> <hash>", id -1 for a kernel named by its hash. */
+   char mark[600];
+   snprintf(mark, sizeof(mark), "%s/compile_failed.txt", sdir);
+   FILE *ff = fopen(mark, "a");
+   if (ff) {
+      fprintf(ff, "%d %s\n", id, hash);
+      fclose(ff);
+   }
+   return false;
+}
+
+/* An id placeholder of an older shim: the kernel hash comes from the shim's map ("<id> <hash>"). */
+static bool
+anv_cm_dyn_kernel(struct anv_device *device, int id, char *path, size_t pathlen)
+{
+   char sdir[512];
+   if (!anv_cm_spv_dir(sdir, sizeof(sdir), true))
+      return false;
+   char mappath[600], hash[32] = "";
+   snprintf(mappath, sizeof(mappath), "%s/map.txt", sdir);
+   FILE *mf = fopen(mappath, "r");
+   if (mf) {
+      char line[128], h[32];
+      int i;
+      while (fgets(line, sizeof(line), mf))
+         if (sscanf(line, "%d %31s", &i, h) == 2 && i == id)
+            snprintf(hash, sizeof(hash), "%s", h);
+      fclose(mf);
+   }
+   if (!hash[0]) {
+      fprintf(stderr, "ANV CM: dynamic kernel %d not in %s\n", id, mappath);
+      return false;
+   }
+   char name[32];
+   snprintf(name, sizeof(name), "dyn_%d", id);
+   return anv_cm_kernel_path(device, sdir, id, name, hash, path, pathlen);
+}
+
+/* The 32-bit constants of a shader in instruction order: vector components in order, a 64-bit constant as its low and
+ * high half. Returns how many were found (at most max). */
+static unsigned
+anv_cm_shader_consts(nir_shader *nir, uint32_t *v, unsigned max)
+{
+   unsigned n = 0;
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_load_const)
+               continue;
+            nir_load_const_instr *lc = nir_instr_as_load_const(instr);
+            for (unsigned c = 0; c < lc->def.num_components; c++) {
+               if (lc->def.bit_size == 32 && n < max) {
+                  v[n++] = lc->value[c].u32;
+               } else if (lc->def.bit_size == 64 && n + 1 < max) {
+                  v[n++] = (uint32_t)lc->value[c].u64;
+                  v[n++] = (uint32_t)(lc->value[c].u64 >> 32);
+               }
+            }
+         }
+      }
+   }
+   return n;
+}
+
+/* The kernel hash a placeholder of the hash format carries in its store of (magic, hash low, hash high). Which
+ * constants hold the halves after vkd3d-proton and NIR depends on the path the store took: one vector, or one scalar
+ * store per dword with the offsets in between. So the candidates are tried in that order - the two values after the
+ * magic, then every pair after it, then every pair - and the first hash the shim wrote a kernel for (<hash>.spv) or
+ * that is in the kernel cache wins. */
+static bool
+anv_cm_placeholder_hash(struct anv_device *device, nir_shader *nir, const char *sdir, char *hash, size_t hashlen)
+{
+   uint32_t v[64];
+   const unsigned n = anv_cm_shader_consts(nir, v, ARRAY_SIZE(v));
+   unsigned m = 0;
+   while (m < n && v[m] != ANV_CM_DUMMY_MAGIC)
+      m++;
+   for (unsigned pass = 0; pass < 3; pass++) {
+      const unsigned from = pass < 2 ? m + 1 : 0;
+      for (unsigned i = from; i < n; i++) {
+         for (unsigned j = from; j < n; j++) {
+            if (pass == 0 && (i != m + 1 || j != m + 2))
+               continue;
+            if (v[i] == ANV_CM_DUMMY_MAGIC || v[j] == ANV_CM_DUMMY_MAGIC)
+               continue;
+            snprintf(hash, hashlen, "%08x%08x", v[j], v[i]);
+            char spv[700], cdir[512], cmk[700];
+            snprintf(spv, sizeof(spv), "%s/%s.spv", sdir, hash);
+            anv_cm_cache_path(device, hash, cdir, sizeof(cdir), cmk, sizeof(cmk));
+            if (access(spv, R_OK) == 0 || access(cmk, R_OK) == 0)
+               return true;
+         }
+      }
+   }
+   fprintf(stderr, "ANV CM: placeholder with no known kernel hash (%u constants) - did the shim write its kernels "
+           "to %s?\n", n, sdir);
+   return false;
+}
+
+/* True if a self-test placeholder of the hash format carries ANV_CM_CANARY_LO/HI: the hash halves of a kernel
+ * placeholder take the same way, so this proves they reach the driver. */
+static bool
+anv_cm_canary_ok(nir_shader *nir)
+{
+   uint32_t v[64];
+   const unsigned n = anv_cm_shader_consts(nir, v, ARRAY_SIZE(v));
+   bool lo = false, hi = false;
+   for (unsigned i = 0; i < n; i++) {
+      lo |= v[i] == ANV_CM_CANARY_LO;
+      hi |= v[i] == ANV_CM_CANARY_HI;
+   }
+   return lo && hi;
+}
+
+/* Every placeholder of the hash format has the same workgroup size, but logs and the debug switches name a kernel by
+ * the x,y of cm_id. So each hash gets the next x,y (1..16 each) in the order this process first sees it. */
+static uint32_t
+anv_cm_log_id(const char *hash)
+{
+   static char seen[256][20];
+   static unsigned nseen;
+   static simple_mtx_t mtx = SIMPLE_MTX_INITIALIZER;
+   simple_mtx_lock(&mtx);
+   unsigned i = 0;
+   while (i < nseen && strcmp(seen[i], hash) != 0)
+      i++;
+   if (i == nseen && nseen < ARRAY_SIZE(seen))
+      snprintf(seen[nseen++], sizeof(seen[0]), "%s", hash);
+   simple_mtx_unlock(&mtx);
+   i = MIN2(i, ARRAY_SIZE(seen) - 1);
+   return (i % 16 + 1) | ((i / 16 + 1) << 8) | (ANV_CM_HASH_WG_Z << 16);
+}
+
+/* Called when a device is created (before the game's XeSS asks the shim which path to take): every kernel listed in
+ * compile_failed.txt is compiled again (once; see below); when all of them succeed the marker is removed and XeSS goes
+ * back to XMX, so a transient failure (disk full, interrupted first launch) heals at the next launch. */
+void
+anv_cm_retry_failed(struct anv_device *device)
+{
+   char sdir[512], mark[600];
+   if (!anv_cm_spv_dir(sdir, sizeof(sdir), false))
+      return;
+   snprintf(mark, sizeof(mark), "%s/compile_failed.txt", sdir);
+   struct stat ms;
+   if (stat(mark, &ms) != 0)
+      return;
+   /* The first failure is followed by exactly one automatic retry (at the next launch). After that the kernels are
+    * tried again only when a graphics component changed after the marker was written - the compiler (helper, igc/),
+    * this driver, or the system's Mesa - or by hand (delete the marker, or run install.sh). A game update is detected
+    * by the shim, which removes the marker when the game's XeSS libraries are newer than it. */
+   int attempts = 1;
+   FILE *f = fopen(mark, "r");
+   if (!f)
+      return;
+   char line[128];
+   while (fgets(line, sizeof(line), f))
+      if (sscanf(line, "# attempts %d", &attempts) == 1)
+         break;
+   fclose(f);
+   {
+      time_t newest = 0;
+      struct stat hs;
+      char helper[600], other[700];
+      if (anv_cm_helper_path(helper, sizeof(helper))) {
+         if (stat(helper, &hs) == 0 && hs.st_mtime > newest)
+            newest = hs.st_mtime;
+         char *slash = strrchr(helper, '/');
+         if (slash)
+            *slash = 0;
+         snprintf(other, sizeof(other), "%s/../igc", helper);
+         if (stat(other, &hs) == 0 && hs.st_mtime > newest)
+            newest = hs.st_mtime;
+      }
+      Dl_info dl;
+      if (dladdr((void *)anv_cm_retry_failed, &dl) && dl.dli_fname && stat(dl.dli_fname, &hs) == 0 && hs.st_mtime > newest)
+         newest = hs.st_mtime;
+      const char *sys[] = { "/usr/lib/libvulkan_intel.so", "/usr/lib/x86_64-linux-gnu/libvulkan_intel.so" };
+      for (unsigned i = 0; i < ARRAY_SIZE(sys); i++)
+         if (stat(sys[i], &hs) == 0 && hs.st_mtime > newest)
+            newest = hs.st_mtime;
+      if (newest > ms.st_mtime) {
+         attempts = 1;
+         fprintf(stderr, "ANV CM: a graphics component changed since the kernels failed to compile: trying again\n");
+      }
+   }
+   if (attempts >= 2) {
+      fprintf(stderr, "ANV CM: kernels failed to compile twice; not retrying until a graphics component or the game "
+              "changes (or %s is removed). XeSS uses its generic paths in this prefix.\n", mark);
+      return;
+   }
+   f = fopen(mark, "r");
+   if (!f)
+      return;
+   char hash[32], keep[64][48];
+   int id, nkeep = 0, ok = 0;
+   while (fgets(line, sizeof(line), f)) {
+      if (line[0] == '#' || sscanf(line, "%d %31s", &id, hash) != 2)
+         continue;
+      char cdir[512], path[700];
+      anv_cm_cache_path(device, hash, cdir, sizeof(cdir), path, sizeof(path));
+      bool done = false;
+      for (int k = 0; k < nkeep; k++)      /* duplicate line of a kernel that failed again */
+         done |= strncmp(keep[k], line, sizeof(keep[k]) - 1) == 0;
+      if (done)
+         continue;
+      char name[32];
+      if (id >= 0)
+         snprintf(name, sizeof(name), "dyn_%d", id);   /* an older shim's id */
+      else
+         snprintf(name, sizeof(name), "%s", hash);
+      if (access(path, R_OK) == 0 || anv_cm_compile(device, sdir, name, hash, cdir, path))
+         ok++;
+      else if (nkeep < 64)
+         snprintf(keep[nkeep++], sizeof(keep[0]), "%d %s\n", id, hash);
+   }
+   fclose(f);
+   if (nkeep == 0) {
+      unlink(mark);
+      fprintf(stderr, "ANV CM: %d previously failed kernel(s) compiled, fallback lifted\n", ok);
+      return;
+   }
+   f = fopen(mark, "w");
+   if (f) {
+      fprintf(f, "# attempts %d\n", attempts + 1);
+      for (int k = 0; k < nkeep; k++)
+         fputs(keep[k], f);
+      fclose(f);
+   }
+   fprintf(stderr, "ANV CM: %d kernel(s) failed to compile again (attempt %d); XeSS uses its generic paths in this prefix\n",
+           nkeep, attempts + 1);
+}
+
+/* The pipeline layout's static sampler (vkd3d-proton turns D3D12 static samplers into immutable samplers). */
+static unsigned
+anv_cm_layout_sampler(const struct vk_shader_compile_info *ci, uint32_t state[4])
+{
+   unsigned count = 0;
+   for (uint32_t i = 0; i < ci->set_layout_count; i++) {
+      const struct anv_descriptor_set_layout *l = (const struct anv_descriptor_set_layout *)ci->set_layouts[i];
+      if (!l)
+         continue;
+      for (uint32_t b = 0; b < l->binding_count; b++) {
+         const struct anv_descriptor_set_binding_layout *bl = &l->binding[b];
+         if (!bl->samplers)
+            continue;
+         for (uint32_t e = 0; e < bl->array_size; e++) {
+            const uint32_t *s = bl->samplers[e].immutable_sampler ?
+                                ANV_CM_SAMPLER_STATE(bl->samplers[e].immutable_sampler) :
+                                bl->samplers[e].embedded_key.sampler;
+            if (count++ == 0)
+               memcpy(state, s, 4 * sizeof(uint32_t));
+         }
+      }
+   }
+   return count;
+}
+
+enum anv_cm_result
+anv_cm_kernel_replace(struct anv_device *device, void *mem_ctx,
+                      struct anv_shader_data *shader_data, nir_shader *nir)
+{
+   const struct anv_cm_env *env = anv_cm_env();
+   const uint32_t wx = nir->info.workgroup_size[0], wy = nir->info.workgroup_size[1], wz = nir->info.workgroup_size[2];
+   uint32_t cm_id = wx | (wy << 8) | (wz << 16);
+   char path[512] = "";
+   if (wx == 1 && wy == 1 && (wz == ANV_CM_CANARY_WG_Z || wz == ANV_CM_LEGACY_CANARY_WG_Z) &&
+       anv_cm_is_placeholder(nir)) {
+      /* the shim's self-test: proves to it that this process runs the patched driver and that placeholders still
+       * reach the driver recognisably (a vkd3d-proton change could break that); the shim checks the time stamp. The
+       * test placeholder of the hash format also has to bring its two test values along. */
+      char sdir[512], mark[600];
+      if (wz == ANV_CM_CANARY_WG_Z && !anv_cm_canary_ok(nir)) {
+         fprintf(stderr, "ANV CM: the self-test placeholder reached the driver without its test values: kernel "
+                 "hashes would not either, so the shim gets no answer and XeSS uses its generic paths\n");
+      } else if (anv_cm_spv_dir(sdir, sizeof(sdir), true)) {
+         anv_cm_mkdirs(sdir);
+         snprintf(mark, sizeof(mark), "%s/anv_canary", sdir);
+         FILE *cf = fopen(mark, "w");
+         if (cf) {
+            fprintf(cf, "patched ANV (xess-xmx-linux) recognised the self-test placeholder\n");
+            fclose(cf);
+         }
+      }
+      return ANV_CM_FAILED;
+   }
+   if (!path[0] && wx == 1 && wy == 1 && wz == ANV_CM_HASH_WG_Z && anv_cm_is_placeholder(nir)) {
+      /* a placeholder that carries its kernel's hash */
+      char sdir[512], hash[32];
+      if (!anv_cm_spv_dir(sdir, sizeof(sdir), true) || !anv_cm_placeholder_hash(device, nir, sdir, hash, sizeof(hash)))
+         return ANV_CM_FAILED;
+      cm_id = anv_cm_log_id(hash);
+      if (env->debug)
+         fprintf(stderr, "ANV CM: kernel %s is %u,%u in this process's log\n", hash, cm_id & 0xff, (cm_id >> 8) & 0xff);
+      if (!anv_cm_kernel_path(device, sdir, -1, hash, hash, path, sizeof(path)))
+         return ANV_CM_FAILED;
+   }
+   /* the id placeholders of an older shim */
+   const int dyn = anv_cm_dyn_id(wx, wy, wz);
+   if (!path[0]) {
+      if (dyn < 0)
+         return ANV_CM_NOT_PLACEHOLDER;
+      if (!anv_cm_is_placeholder(nir)) {
+         if (env->debug)
+            fprintf(stderr, "ANV CM: workgroup %u,%u,%u is not a placeholder, left alone\n", wx, wy, wz);
+         return ANV_CM_NOT_PLACEHOLDER;
+      }
+      if (!anv_cm_dyn_kernel(device, dyn, path, sizeof(path)))
+         return ANV_CM_FAILED;
+   }
+   if (env->debug) {
+      const struct vk_shader_compile_info *ci = shader_data->info;
+      fprintf(stderr, "ANV CM: placeholder wg %u,%u,%u -> %s (sets %u)\n", wx, wy, wz, path, ci->set_layout_count);
+      for (uint32_t i = 0; i < ci->set_layout_count; i++) {
+         if (!ci->set_layouts[i])
+            continue;
+         const struct anv_descriptor_set_layout *l = (const struct anv_descriptor_set_layout *)ci->set_layouts[i];
+         fprintf(stderr, "ANV CM:   set %u: type %d bindings %u descriptors %u\n", i, ANV_CM_SET_LAYOUT_MODE(l), l->binding_count, l->descriptor_count);
+      }
+   }
+   FILE *f = fopen(path, "rb");
+   if (!f) {
+      fprintf(stderr, "ANV CM: cannot open %s\n", path);
+      return ANV_CM_FAILED;
+   }
+   struct cmk_header h;
+   if (fread(&h, sizeof(h), 1, f) != 1 || memcmp(h.magic, "CMK2", 4) != 0 ||
+       h.code_size == 0 || h.code_size > (16u << 20) ||
+       h.lws[0] == 0 || h.lws[0] > 32 || h.lws[1] == 0 || h.lws[2] == 0 ||
+       h.lws[0] * h.lws[1] * h.lws[2] > 1024 ||
+       h.cross_size > sizeof(h.cross_data) || (h.per_thread_size != 0 && h.per_thread_size < 6) ||
+       h.nsurf > 24) {
+      fprintf(stderr, "ANV CM: bad header in %s (lws %u,%u,%u cross %u per-thread %u surfaces %u)\n", path,
+              h.lws[0], h.lws[1], h.lws[2], h.cross_size, h.per_thread_size, h.nsurf);
+      fclose(f);
+      return ANV_CM_FAILED;
+   }
+   /* the binding table is built from the direct descriptor layout */
+   if (device->physical->indirect_descriptors) {
+      fprintf(stderr, "ANV CM: %s needs direct descriptors (force_indirect_descriptors is set)\n", path);
+      fclose(f);
+      return ANV_CM_FAILED;
+   }
+   void *code = ralloc_size(mem_ctx, h.code_size);
+   if (fread(code, 1, h.code_size, f) != h.code_size) {
+      fprintf(stderr, "ANV CM: short read in %s\n", path);
+      fclose(f);
+      return ANV_CM_FAILED;
+   }
+   fclose(f);
+
+   struct brw_cs_prog_data *cs = &shader_data->prog_data.cs;
+   const struct brw_cs_prog_data saved = *cs;
+   memset(cs, 0, sizeof(*cs));
+   cs->base.source_hash = saved.base.source_hash;   /* anv_shader_compile asserts the compiler left it alone */
+   cs->base.program_size = h.code_size;
+   cs->base.grf_used = h.grf_count;
+   cs->base.total_shared = h.slm_size;
+   cs->uses_barrier = (h.barriers & 0x7fffffffu) > 0;
+   cs->cm_has_sampler = (h.barriers & 0x80000000u) != 0;
+   /* One HW thread per CM work item: dispatch as SIMD32 over lws*32 so that threads == lws.x*lws.y*lws.z */
+   cs->local_size[0] = h.lws[0] * 32;
+   cs->local_size[1] = h.lws[1];
+   cs->local_size[2] = h.lws[2];
+   cs->prog_mask = 1 << 2;
+   cs->prog_offset[2] = 0;
+   cs->uses_cm_kernel = true;
+   cs->cm_no_cache = true;
+   cs->cm_id = cm_id;
+   memcpy(cs->cm_local, h.lws, sizeof(h.lws));
+   cs->cm_cross_thread_size = h.cross_size;
+   cs->cm_per_thread_size = h.per_thread_size;
+   memcpy(cs->cm_cross_thread_data, h.cross_data, sizeof(h.cross_data));
+
+   const struct vk_shader_compile_info *ci = shader_data->info;
+   if (cs->cm_has_sampler) {
+      const unsigned ns = anv_cm_layout_sampler(ci, cs->cm_sampler_state);
+      cs->cm_sampler_from_layout = ns > 0;
+      if (ns != 1)
+         fprintf(stderr, "ANV CM: %s samples but the pipeline layout has %u static samplers (%s)\n", path, ns,
+                 ns ? "using the first" : "using linear/clamp");
+   }
+
+   if (h.nsurf > 0) {
+      const struct anv_descriptor_set_layout *l = NULL;
+      const bool auto_heap = h.heap_set == 0xffffffffu;
+      if (auto_heap) {
+         /* vkd3d-proton: the descriptor heap is the MUTABLE binding with a huge array */
+         for (uint32_t i = 0; i < ci->set_layout_count && !l; i++) {
+            const struct anv_descriptor_set_layout *cand =
+               (const struct anv_descriptor_set_layout *)ci->set_layouts[i];
+            if (!cand)
+               continue;
+            for (uint32_t b = 0; b < cand->binding_count; b++) {
+               if (cand->binding[b].type == VK_DESCRIPTOR_TYPE_MUTABLE_EXT &&
+                   cand->binding[b].array_size >= 1000) {
+                  h.heap_set = i;
+                  h.heap_binding = b;
+                  l = cand;
+                  break;
+               }
+            }
+         }
+      } else if (h.heap_set < ci->set_layout_count && ci->set_layouts[h.heap_set]) {
+         l = (const struct anv_descriptor_set_layout *)ci->set_layouts[h.heap_set];
+      }
+      if (auto_heap) {
+         /* vkd3d push constants end with one u32 per descriptor-table root parameter; the kernel's surfaces are
+          * the last h.nsurf tables (table_idx counts from the first of those) */
+         uint32_t push_size = 0;
+         for (uint32_t r = 0; r < ci->push_constant_range_count; r++)
+            push_size = MAX2(push_size, ci->push_constant_ranges[r].offset + ci->push_constant_ranges[r].size);
+         h.table_pc_base = push_size >= 4 * h.nsurf ? push_size - 4 * h.nsurf : ~0u;
+      }
+      if (!l || h.heap_binding >= l->binding_count || h.nsurf > 24 || h.table_pc_base == ~0u) {
+         fprintf(stderr, "ANV CM: %s: no vkd3d-style descriptor heap in the pipeline layout (%u sets) - "
+                 "is VKD3D_DISABLE_EXTENSIONS=VK_EXT_descriptor_buffer set?\n", path, ci->set_layout_count);
+         *cs = saved;
+         return ANV_CM_FAILED;
+      }
+      cs->cm_nsurf = h.nsurf;
+      cs->cm_heap_set = h.heap_set;
+      cs->cm_heap_desc_off = l->binding[h.heap_binding].descriptor_surface_offset;
+      cs->cm_heap_stride = l->binding[h.heap_binding].descriptor_surface_stride;
+      for (uint32_t k = 0; k < h.nsurf; k++) {
+         cs->cm_bti[k] = h.bti[k];
+         cs->cm_table_pc_off[k] = h.table_pc_base + 4 * h.table_idx[k];
+         cs->cm_elem[k] = h.elem[k];
+         cs->cm_max_bti = MAX2(cs->cm_max_bti, h.bti[k]);
+      }
+      if (env->debug)
+         fprintf(stderr, "ANV CM: heap set %u binding %u: descriptor offset %u stride %u (set layout type %d)\n",
+                 h.heap_set, h.heap_binding, cs->cm_heap_desc_off, cs->cm_heap_stride, ANV_CM_SET_LAYOUT_MODE(l));
+   }
+
+   shader_data->bind_map.inline_dwords_count = 0;
+   shader_data->num_stats = 1;
+   memset(&shader_data->stats[0], 0, sizeof(shader_data->stats[0]));
+   shader_data->stats[0].dispatch_width = 32;
+   shader_data->code = code;
+
+   if (env->debug)
+      fprintf(stderr, "ANV CM: injected %s (%u bytes code, %u GRF, lws %u,%u,%u)\n",
+              path, h.code_size, h.grf_count, h.lws[0], h.lws[1], h.lws[2]);
+   return ANV_CM_INJECTED;
+}
diff --git a/src/intel/vulkan/anv_cm.h b/src/intel/vulkan/anv_cm.h
