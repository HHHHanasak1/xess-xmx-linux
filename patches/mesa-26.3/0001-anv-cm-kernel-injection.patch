index 0000000..42f978e
--- /dev/null
+++ b/src/intel/vulkan/anv_cm.h
@@ -0,0 +1,69 @@
+/*
+ * Copyright © 2026 xess-xmx-linux contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* C-for-Metal kernel injection (xess-xmx-linux). anv_cm.c holds the generation-independent part (placeholders,
+ * kernel cache, run-time compile, .cmk loading), genX_cm.c the per-generation part (binding table, walker payload).
+ * The upstream files only call into them. What differs between the Mesa versions the patches support is hidden
+ * behind the ANV_CM_* macros and anv_cm_bind_state in anv_private.h, so that these three files are the same in
+ * every patch series. */
+#ifndef ANV_CM_H
+#define ANV_CM_H
+
+#include "anv_private.h"
+
+/* environment of the C-for-Metal kernel injection, read once */
+struct anv_cm_env {
+   const char *kernel_dir;   /* ANV_CM_KERNEL_DIR */
+   bool debug;               /* ANV_CM_DEBUG */
+   int trace;                /* ANV_CM_TRACE=1|2 */
+};
+const struct anv_cm_env *anv_cm_env(void);
+void anv_cm_retry_failed(struct anv_device *device);
+
+enum anv_cm_result {
+   ANV_CM_NOT_PLACEHOLDER,
+   ANV_CM_INJECTED,
+   ANV_CM_FAILED,        /* placeholder whose kernel is missing: compiled as the (no-op) placeholder, not cached */
+};
+
+struct anv_shader_data;
+
+enum anv_cm_result
+anv_cm_kernel_replace(struct anv_device *device, void *mem_ctx,
+                      struct anv_shader_data *shader_data, nir_shader *nir);
+
+/* An injected kernel whose binding table genX(cm_emit_binding_table) builds from the descriptor heap */
+static inline bool
+anv_cm_has_binding_table(const struct anv_shader *shader)
+{
+   const struct brw_cs_prog_data *cm = (const struct brw_cs_prog_data *)shader->prog_data;
+   return shader->vk.stage == MESA_SHADER_COMPUTE && cm->uses_cm_kernel && cm->cm_nsurf > 0;
+}
+
+
+#ifdef genX
+/* genX_cm.c; only visible to the per-generation files that include this header after genxml/gen_macros.h */
+VkResult
+genX(cm_emit_binding_table)(struct anv_cmd_buffer *cmd_buffer,
+                            anv_cm_bind_state *bind_state,
+                            const struct anv_shader *shader,
+                            struct anv_state *bt_state);
+
+void
+genX(cm_before_walker)(struct anv_cmd_buffer *cmd_buffer,
+                       const struct brw_cs_prog_data *prog_data,
+                       uint32_t num_wg[3], uint32_t threads);
+
+#if GFX_VERx10 >= 125
+void
+genX(cm_setup_walker)(struct anv_device *device,
+                      struct anv_shader *shader,
+                      const struct brw_cs_prog_data *cs_prog_data,
+                      uint32_t threads,
+                      struct GENX(COMPUTE_WALKER_BODY) *walker);
+#endif
+#endif /* genX */
+
+#endif /* ANV_CM_H */
