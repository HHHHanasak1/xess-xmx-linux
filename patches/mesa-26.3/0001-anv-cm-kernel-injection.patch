diff --git a/src/intel/vulkan/genX_cm.c b/src/intel/vulkan/genX_cm.c
new file mode 100644
index 0000000..1d58ccb
--- /dev/null
+++ b/src/intel/vulkan/genX_cm.c
@@ -0,0 +1,168 @@
+/*
+ * Copyright © 2026 xess-xmx-linux contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* C-for-Metal kernel injection (xess-xmx-linux), per hardware generation: the binding table of an injected kernel
+ * built at each dispatch, the trace of its walker and the walker's indirect payload. See anv_cm.c. */
+#include <stdio.h>
+
+#include "anv_private.h"
+
+#include "genxml/gen_macros.h"
+#include "genxml/genX_pack.h"
+
+#include "anv_cm.h"
+
+VkResult
+genX(cm_emit_binding_table)(struct anv_cmd_buffer *cmd_buffer,
+                            anv_cm_bind_state *bind_state,
+                            const struct anv_shader *shader,
+                            struct anv_state *bt_state)
+{
+   uint32_t state_offset;
+
+   /* xess-xmx-linux: binding table of an injected C-for-Metal kernel, built per dispatch from the vkd3d-style
+    * descriptor heap (surface k = heap index push_constant[table] + element) */
+   const struct brw_cs_prog_data *cm = (const struct brw_cs_prog_data *)shader->prog_data;
+   const struct anv_cm_env *env = anv_cm_env();
+   const unsigned kx = cm->cm_id & 0xff, ky = (cm->cm_id >> 8) & 0xff, kz = cm->cm_id >> 16;
+   const uint32_t nent = cm->cm_max_bti + 1;
+   *bt_state = anv_cmd_buffer_alloc_binding_table(cmd_buffer, nent, &state_offset);
+   if (bt_state->map == NULL)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   uint32_t *cm_bt = bt_state->map;
+   if (cm->cm_has_sampler) {
+      struct anv_state sst = anv_cmd_buffer_alloc_dynamic_state(cmd_buffer, 16, 32);
+      if (sst.map == NULL)
+         return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      if (cm->cm_sampler_from_layout) {
+         /* the static sampler of the D3D12 root signature (an immutable sampler of the pipeline layout) */
+         memcpy(sst.map, cm->cm_sampler_state, 16);
+      } else {
+         /* no static sampler found: XeSS' own is MIN_MAG_MIP_LINEAR, CLAMP on all axes, normalised coordinates */
+         struct GENX(SAMPLER_STATE) smp = {
+            .SamplerDisable = false,
+            .TextureBorderColorMode = DX10OGL,
+#if GFX_VER >= 11
+            .CPSLODCompensationEnable = cmd_buffer->device->info->ver < 20,
+#endif
+            .LODPreClampMode = CLAMP_MODE_OGL,
+            .MipModeFilter = MIPFILTER_LINEAR,
+            .MagModeFilter = MAPFILTER_LINEAR,
+            .MinModeFilter = MAPFILTER_LINEAR,
+            .TextureLODBias = 0,
+            .AnisotropicAlgorithm = LEGACY,
+            .MinLOD = 0,
+            .MaxLOD = 14,
+            .ShadowFunction = PREFILTEROP_NEVER,
+            .CubeSurfaceControlMode = OVERRIDE,
+            .LODClampMagnificationMode = MIPNONE,
+            .MaximumAnisotropy = RATIO21,
+            .RAddressMinFilterRoundingEnable = true,
+            .RAddressMagFilterRoundingEnable = true,
+            .VAddressMinFilterRoundingEnable = true,
+            .VAddressMagFilterRoundingEnable = true,
+            .UAddressMinFilterRoundingEnable = true,
+            .UAddressMagFilterRoundingEnable = true,
+            .TrilinearFilterQuality = 0,
+            .NonnormalizedCoordinateEnable = false,
+            .TCXAddressControlMode = TCM_CLAMP,
+            .TCYAddressControlMode = TCM_CLAMP,
+            .TCZAddressControlMode = TCM_CLAMP,
+         };
+         GENX(SAMPLER_STATE_pack)(NULL, sst.map, &smp);
+      }
+      cmd_buffer->state.samplers[MESA_SHADER_COMPUTE] = sst;
+   }
+   memset(cm_bt, 0, nent * sizeof(uint32_t));
+   const uint32_t *pc = (const uint32_t *)bind_state->push_constants.client_data;
+   const struct anv_descriptor_set *hs = bind_state->descriptors[cm->cm_heap_set];
+   if (hs == NULL || hs->layout == NULL) {
+      /* heap set not bound: every surface gets the null surface instead of a wild pointer */
+      static bool warned;
+      if (!warned) {
+         warned = true;
+         fprintf(stderr, "ANV CM: kernel %u,%u,%u dispatched without its descriptor heap (set %u) bound\n",
+                 kx, ky, kz, cm->cm_heap_set);
+      }
+      const struct anv_state ns = anv_null_surface_state_for_binding_table(cmd_buffer->device);
+      for (uint32_t k = 0; k < cm->cm_nsurf; k++)
+         cm_bt[cm->cm_bti[k]] = ns.offset + state_offset;
+      return VK_SUCCESS;
+   }
+   if (env->trace)
+      fprintf(stderr, "ANV CM: dispatch kernel %u,%u,%u idx:", kx, ky, kz);
+   for (uint32_t k = 0; k < cm->cm_nsurf; k++) {
+      const uint32_t idx = pc[cm->cm_table_pc_off[k] / 4] + cm->cm_elem[k];
+      if (env->trace)
+         fprintf(stderr, " %u", idx);
+      if (idx >= hs->layout->descriptor_count) {
+         struct anv_state ns = anv_null_surface_state_for_binding_table(cmd_buffer->device);
+         cm_bt[cm->cm_bti[k]] = ns.offset + state_offset;
+         fprintf(stderr, "ANV CM: kernel %u,%u,%u surface %u heap index %u out of range (%u), null surface used\n",
+                 kx, ky, kz, k, idx, hs->layout->descriptor_count);
+         continue;
+      }
+      cm_bt[cm->cm_bti[k]] = hs->desc_offset + cm->cm_heap_desc_off +
+                             idx * cm->cm_heap_stride + state_offset;
+      if (env->trace == 2) {
+         const uint32_t *ss = (const uint32_t *)((const char *)hs->desc_surface_mem.map +
+                              cm->cm_heap_desc_off + idx * cm->cm_heap_stride);
+         fprintf(stderr, "\nANV CM:   surf %u heap %u state:", k, idx);
+         for (int d = 0; d < 16; d++)
+            fprintf(stderr, " %08x", ss[d]);
+      }
+   }
+   if (env->trace)
+      fprintf(stderr, "\n");
+   return VK_SUCCESS;
+}
+
+void
+genX(cm_before_walker)(struct anv_cmd_buffer *cmd_buffer,
+                       const struct brw_cs_prog_data *prog_data,
+                       uint32_t num_wg[3], uint32_t threads)
+{
+   const struct anv_cm_env *env = anv_cm_env();
+   if (env->trace)
+      fprintf(stderr, "ANV CM: walker kernel %u,%u,%u groups %u,%u,%u threads %u\n",
+              prog_data->cm_id & 0xff, (prog_data->cm_id >> 8) & 0xff, prog_data->cm_id >> 16,
+              num_wg[0], num_wg[1], num_wg[2], threads);
+}
+
+#if GFX_VERx10 >= 125
+void
+genX(cm_setup_walker)(struct anv_device *device,
+                      struct anv_shader *shader,
+                      const struct brw_cs_prog_data *cs_prog_data,
+                      uint32_t threads,
+                      struct GENX(COMPUTE_WALKER_BODY) *walker)
+{
+   /* NEO-style payload: [cross-thread data][per-thread data * threads], loaded by the walker from the
+    * indirect object heap (base address 0, so the general state pool offset is the address). */
+   const uint32_t cross = cs_prog_data->cm_cross_thread_size;
+   const uint32_t per = cs_prog_data->cm_per_thread_size;
+   const uint32_t total = cross + per * threads;
+   shader->cm_indirect = anv_state_pool_alloc(&device->general_state_pool,
+                                              align(total, 64), 64);
+   memset(shader->cm_indirect.map, 0, align(total, 64));
+   memcpy(shader->cm_indirect.map, cs_prog_data->cm_cross_thread_data,
+          MIN2(cross, sizeof(cs_prog_data->cm_cross_thread_data)));
+   const uint32_t lx = cs_prog_data->cm_local[0];
+   const uint32_t ly = cs_prog_data->cm_local[1];
+   /* packed local ids, only if the kernel takes them (per == 0: no per-thread argument, nothing to write) */
+   for (uint32_t t = 0; per >= 6 && t < threads; t++) {
+      uint16_t *ids = (uint16_t *)((char *)shader->cm_indirect.map + cross + t * per);
+      ids[0] = t % lx;
+      ids[1] = (t / lx) % ly;
+      ids[2] = t / (lx * ly);
+   }
+   walker->IndirectDataLength = total;
+   if (cs_prog_data->cm_has_sampler)
+      walker->InterfaceDescriptor.SamplerCount = 1;
+   if (cs_prog_data->cm_nsurf > 0)
+      walker->InterfaceDescriptor.BindingTableEntryCount = MIN2(cs_prog_data->cm_max_bti + 1, 31);
+   walker->IndirectDataStartAddress = shader->cm_indirect.offset;
+}
+#endif
