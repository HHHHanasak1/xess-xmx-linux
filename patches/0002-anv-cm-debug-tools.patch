From 73b402f7beed42075edcc370785eaeb42c2a07e8 Mon Sep 17 00:00:00 2001
From: xess-xmx-linux <xmx@localhost>
Date: Fri, 25 Sep 2026 03:06:39 +0900
Subject: [PATCH 2/2] anv: debug tools for the C-for-Metal kernel injection
 (xess-xmx-linux)

---
 src/intel/vulkan/anv_shader_compile.c | 32 +++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/src/intel/vulkan/anv_shader_compile.c b/src/intel/vulkan/anv_shader_compile.c
index 62f40a8..a9c0a96 100644
--- a/src/intel/vulkan/anv_shader_compile.c
+++ b/src/intel/vulkan/anv_shader_compile.c
@@ -1236,6 +1236,18 @@ anv_cm_env_init(void)
    e->debug = getenv("ANV_CM_DEBUG") != NULL;
    const char *t = getenv("ANV_CM_TRACE");
    e->trace = t ? (t[0] == '2' ? 2 : 1) : 0;
+   e->pc = getenv("ANV_CM_PC") != NULL;
+   e->view = getenv("ANV_CM_VIEW");
+   e->gcap = getenv("ANV_CM_GCAP");
+   e->capture = getenv("ANV_CM_CAPTURE");
+   e->only = getenv("ANV_CM_ONLY");
+   e->skip = getenv("ANV_CM_SKIP");
+   e->sync = getenv("ANV_CM_SYNC") != NULL;
+   const char *mg = getenv("ANV_CM_MAXGROUPS");
+   e->maxgroups = mg ? (uint32_t)atoi(mg) : 0;
+   const char *pr = getenv("ANV_CM_PREEMPT");
+   e->preempt = pr ? atoi(pr) != 0 : -1;
+   e->cap_dir = getenv("ANV_CM_CAP_DIR") ? getenv("ANV_CM_CAP_DIR") : "/tmp/anv_cm_cap";
 }
 
 const struct anv_cm_env *
@@ -1531,6 +1543,15 @@ anv_cm_kernel_replace(struct anv_device *device, void *mem_ctx,
    const struct anv_cm_env *env = anv_cm_env();
    const uint32_t wx = nir->info.workgroup_size[0], wy = nir->info.workgroup_size[1], wz = nir->info.workgroup_size[2];
    char path[512] = "";
+   /* developer route: a .cmk named after the SPIR-V's blake3 replaces any compute shader (own test kernels) */
+   if (env->kernel_dir) {
+      char hex[33];
+      for (int i = 0; i < 16; i++)
+         snprintf(hex + 2 * i, 3, "%02x", nir->info.source_blake3[i]);
+      snprintf(path, sizeof(path), "%s/%s.cmk", env->kernel_dir, hex);
+      if (access(path, R_OK) != 0)
+         path[0] = 0;
+   }
    const int dyn = anv_cm_dyn_id(wx, wy, wz);
    if (!path[0]) {
       if (wz != 5 && dyn < 0)
@@ -1562,6 +1583,17 @@ anv_cm_kernel_replace(struct anv_device *device, void *mem_ctx,
          fprintf(stderr, "ANV CM:   set %u: type %d bindings %u descriptors %u\n", i, (int)l->type, l->binding_count, l->descriptor_count);
       }
    }
+   {
+      /* ANV_CM_ONLY="x,y x,y ..." injects only these kernels, ANV_CM_SKIP the listed ones are left as placeholders */
+      char key[32], onlyp[2048], skipp[2048];
+      snprintf(key, sizeof(key), " %u,%u ", wx, wy);
+      snprintf(onlyp, sizeof(onlyp), " %s ", env->only ? env->only : "");
+      snprintf(skipp, sizeof(skipp), " %s ", env->skip ? env->skip : "");
+      if ((env->only && !strstr(onlyp, key)) || (env->skip && strstr(skipp, key))) {
+         fprintf(stderr, "ANV CM: kernel %s not injected (ONLY/SKIP)\n", key);
+         return ANV_CM_FAILED;
+      }
+   }
    FILE *f = fopen(path, "rb");
    if (!f) {
       fprintf(stderr, "ANV CM: cannot open %s\n", path);
